# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# ── Database (PostgreSQL) ───────────────────────────────────────────
DATABASE_URL=postgresql://bcp:bcp_dev_password@localhost:5432/bcp_studio_os
DIRECT_URL=postgresql://bcp:bcp_dev_password@localhost:5432/bcp_studio_os

# ── Redis (cache, queues, sessions) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO — S3 compatible) ──────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=bcp_minio_admin
S3_SECRET_ACCESS_KEY=bcp_minio_password
S3_BUCKET=bcp-studio-os-dev
S3_FORCE_PATH_STYLE=true

# ── Email (Mailpit locally) ──────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="BCP Studio OS <no-reply@bcpstudio.local>"

# ── Auth ─────────────────────────────────────────────────────────────
AUTH_SECRET=replace_with_openssl_rand_-base64_32
AUTH_URL=http://localhost:3000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── WhatsApp Business API ───────────────────────────────────────────
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── AI provider (Anthropic) ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Google OAuth (sign in with Google) ───────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ── Two-factor authentication ────────────────────────────────────────
# openssl rand -base64 32
TWO_FACTOR_ENCRYPTION_KEY=

# ── Custom domain routing ─────────────────────────────────────────────
DOMAIN_CNAME_TARGET=domains.bcpstudio.os
DOMAIN_APEX_IPS=203.0.113.10,203.0.113.11
PLATFORM_HOSTNAMES=localhost,bcpstudio.os

# ── Payments ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Licensing (platform-admin issued keys) ──────────────────────────
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=

# ── Observability ────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
