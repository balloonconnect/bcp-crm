/// White-label theming for a studio — 1:1. Powers @bcp/branding's theme
/// resolution and CSS-variable generation (platform default → this row →
/// BranchBrand override — see packages/branding/docs/branding.md).
/// Typed columns for well-defined visual tokens; JSON only where a field
/// is genuinely composite (social links, per-surface theme overrides) —
/// see docs/database-conventions.md § "JSON columns".
model StudioBrand {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @unique @map("studio_id") @db.Uuid

  // Identity
  displayName        String? @map("display_name") // falls back to Studio.name if unset
  legalBusinessName  String? @map("legal_business_name")

  // Logos & favicon
  logoUrl      String? @map("logo_url") // default/general-purpose logo
  logoLightUrl String? @map("logo_light_url") // for dark backgrounds
  logoDarkUrl  String? @map("logo_dark_url") // for light backgrounds
  faviconUrl   String? @map("favicon_url")

  // Color tokens
  primaryColor    String  @default("#14161A") @map("primary_color")
  secondaryColor  String? @map("secondary_color")
  accentColor     String  @default("#E8A33D") @map("accent_color")
  backgroundColor String? @map("background_color")
  textColor       String? @map("text_color")

  // Typography & shape
  fontFamilyBody    String? @map("font_family_body")
  fontFamilyHeading String? @map("font_family_heading")
  borderRadius      Int     @default(8) @map("border_radius") // px
  buttonStyle       String  @default("solid") @map("button_style") // solid | outline | ghost | pill
  cardStyle         String  @default("elevated") @map("card_style") // flat | elevated | bordered

  // Surfaces
  loginBackgroundUrl String? @map("login_background_url")
  emailHeaderImageUrl String? @map("email_header_image_url")
  emailHeaderHtml     String? @map("email_header_html")
  emailFooterHtml     String? @map("email_footer_html")
  emailFromName       String? @map("email_from_name")
  emailFromAddress    String? @map("email_from_address")

  // Watermark (applied to galleries/album previews)
  watermarkUrl      String? @map("watermark_url")
  watermarkOpacity  Float   @default(0.5) @map("watermark_opacity")
  watermarkPosition String  @default("bottom_right") @map("watermark_position")

  // Per-surface theme overrides (subset of the color/typography tokens above)
  invoiceDesign     Json? @map("invoice_design")
  galleryTheme      Json? @map("gallery_theme")
  clientPortalTheme Json? @map("client_portal_theme")

  // Contact & legal footer content
  copyrightText      String?  @map("copyright_text")
  supportEmail       String?  @map("support_email")
  whatsappNumber      String?  @map("whatsapp_number")
  whatsappDisplayName String? @map("whatsapp_display_name")
  socialLinks         Json?   @map("social_links") // [{ platform, url }]

  poweredByVisible Boolean @default(true) @map("powered_by_visible")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@map("studio_brands")
}

/// Branch-level theme override — a JSON delta merged over StudioBrand at
/// resolution time (see @bcp/branding resolve-theme.ts). JSON here (unlike
/// StudioBrand's typed columns) because most branches override zero or one
/// field (e.g. just a different login background per city), and a second
/// full set of ~25 nullable columns for the rare full-override case isn't
/// worth the schema weight — see docs/database-conventions.md § "JSON
/// columns" for the same reasoning applied elsewhere.
model BranchBrand {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  branchId String @unique @map("branch_id") @db.Uuid

  overrides Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  studio Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  branch StudioBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("branch_brands")
}

/// Immutable snapshot of a StudioBrand row, written every time it changes
/// — theme version history + rollback. `version` is a simple incrementing
/// integer per studio (not a timestamp), so "rollback to version 3" reads
/// naturally in a UI. Rollback (see branding.service.ts in apps/api)
/// applies a past snapshot's `snapshot` JSON back onto StudioBrand and
/// itself creates a *new* version — history is append-only, never rewritten.
model StudioBrandVersion {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  version  Int
  snapshot Json
  note     String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, version])
  @@index([studioId])
  @@map("studio_brand_versions")
}

/// Custom domain(s) mapped to a studio (e.g. booking.mystudio.com). A
/// studio may have several, serving different purposes (`DomainPurpose`)
/// — CRM, client portal, gallery, enquiry form, or the white-label root
/// website — with at most one `isPrimary` domain *per purpose*, enforced
/// by a partial unique index — see migration
/// `20260710000400_custom_domains`. Domain audit events (add, verify,
/// activate, remove) are recorded in `AuditLog` with
/// `resourceType = "StudioDomain"` rather than a dedicated table — see
/// docs/database-conventions.md § "Audit columns" for why one audit
/// mechanism is reused rather than duplicated per resource.
model StudioDomain {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  domain  String        @unique
  purpose DomainPurpose @default(studio_crm)
  status  DomainStatus  @default(pending)

  isPrimary Boolean @default(false) @map("is_primary") // at most one true per (studio, purpose) — see migration 20260710000400

  verificationMethod         DomainVerificationMethod @default(txt) @map("verification_method")
  verificationToken          String?                  @map("verification_token") // TXT record value to publish
  cnameTarget                String?                  @map("cname_target") // expected CNAME target for verification_method = cname
  verificationAttempts       Int                      @default(0) @map("verification_attempts")
  lastVerificationAttemptAt  DateTime?                @map("last_verification_attempt_at")
  nextRetryAt                DateTime?                @map("next_retry_at")
  verifiedAt                 DateTime?                @map("verified_at")

  sslStatus    DomainSslStatus @default(none) @map("ssl_status")
  sslIssuedAt  DateTime?       @map("ssl_issued_at")
  sslExpiresAt DateTime?       @map("ssl_expires_at")

  activatedAt DateTime? @map("activated_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") // domain removal is a soft delete — see custom-domains.md § "Domain removal"

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([studioId, purpose])
  @@index([status])
  @@index([nextRetryAt])
  @@map("studio_domains")
}

/// A physical branch/location of a studio. Referenced by StudioUser (home
/// branch) and, in later phases, by bookings/events/galleries.
model StudioBranch {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  name      String
  code      String?
  address   String?
  city      String?
  state     String?
  country   String  @default("IN")
  phone     String?
  isPrimary Boolean @default(false) @map("is_primary") // at most one true per studio — see migration 20260710000100
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  studio Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  users  StudioUser[]
  brand  BranchBrand?

  @@unique([studioId, code])
  @@index([studioId])
  @@index([studioId, isActive])
  @@map("studio_branches")
}

/// Flexible per-studio key/value settings (business hours, invoice prefix,
/// default currency overrides, …) without a schema migration per setting.
model StudioSetting {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  key   String
  value Json

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, key])
  @@index([studioId])
  @@map("studio_settings")
}

// ═══════════════════════════════════════════════════════════════════════
// STUDIO — identity, RBAC, invitations
// ═══════════════════════════════════════════════════════════════════════

/// A person's membership + credentials within one studio. A person who
/// works across multiple studios (e.g. a freelance photographer) gets one
/// StudioUser row per studio — see docs/tenant-isolation.md
/// "Users in multiple studios" for why membership, not a global account,
/// is the right unit here, and how a shared email is linked in the UI.
model StudioUser {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid

  email        String
  passwordHash String?           @map("password_hash")
  name         String
  avatarUrl    String?           @map("avatar_url")
  phone        String?
  status       StudioUserStatus  @default(invited)
  lastLoginAt  DateTime?         @map("last_login_at")

  emailVerifiedAt DateTime? @map("email_verified_at")
  googleSubject   String?   @map("google_subject")

  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?   @map("two_factor_secret") // encrypted at rest by the app layer, never plaintext
  twoFactorEnabledAt  DateTime? @map("two_factor_enabled_at")

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  employmentType     EmploymentType?     @map("employment_type") // null = not yet classified (e.g. a still-pending invite)
  skills             String[]            @default([])
  availabilityStatus AvailabilityStatus  @default(available) @map("availability_status")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  studio        Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  branch        StudioBranch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  roles         StudioUserRole[]
  eventAssignments EventAssignment[]
  bookingTeamAssignments BookingTeamAssignment[]
  dashboardPreference DashboardPreference?
  notifications Notification[]
  tasksAssigned     Task[] @relation("TaskAssignee")
  tasksEscalatedTo  Task[] @relation("TaskEscalatedTo")
  teamProfile          TeamMemberProfile?
  teamDocuments        TeamDocument[]
  teamEquipment        TeamEquipmentAssignment[]
  attendanceRecords    AttendanceRecord[]
  leaveRequests        LeaveRequest[]
  performanceNotes     PerformanceNote[]
  freelancerPayments   FreelancerPayment[]
  equipmentCheckoutRecords EquipmentCheckoutRecord[]
  notificationPreference   NotificationPreference?
  pushSubscriptions        PushSubscription[]
  designedAlbums           Album[]
  copilotConversations     CopilotConversation[]
  copilotAuditLogEntries   CopilotAuditLogEntry[]
  recentSearches           RecentSearch[]
  savedSearches            SavedSearch[]

  @@unique([studioId, email])
  @@unique([studioId, googleSubject])
  @@index([studioId])
  @@index([studioId, branchId])
  @@index([studioId, status])
  @@index([deletedAt])
  @@map("studio_users")
}

/// Catalog of permission keys studio-side roles can be built from, e.g.
/// "booking:manage", "gallery:view". Global catalog (not tenant-scoped) —
/// the set of things the product *can* gate is fixed by the codebase, even
/// though which roles grant them is per-studio.
model StudioPermission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  label       String
  description String?
  category    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("studio_permissions")
}

/// A role scoped to one studio. Every studio gets the system default roles
/// seeded on creation (`isSystem = true`, see prisma/seed.ts); studio
/// owners/admins can additionally create custom roles with any subset of
/// StudioPermission keys.
model StudioRole {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  permissions String[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  studio      Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  userRoles   StudioUserRole[]
  invitations Invitation[]

  @@unique([studioId, key])
  @@index([studioId])
  @@map("studio_roles")
}

/// Join table: which studio roles a studio user holds. A user can hold
/// more than one role (e.g. "photographer" + "editor").
model StudioUserRole {
  id           String   @id @default(uuid()) @db.Uuid
  studioUserId String   @map("studio_user_id") @db.Uuid
  studioRoleId String   @map("studio_role_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedBy   String?  @map("assigned_by") @db.Uuid

  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)
  studioRole StudioRole @relation(fields: [studioRoleId], references: [id], onDelete: Cascade)

  @@unique([studioUserId, studioRoleId])
  @@index([studioRoleId])
  @@map("studio_user_roles")
}

/// A pending invite for someone to join a studio with a given role (and
/// optionally a specific home branch). Accepting an invitation creates the
/// StudioUser row.
model Invitation {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  email      String
  roleId     String           @map("role_id") @db.Uuid
  branchId   String?          @map("branch_id") @db.Uuid
  token      String           @unique
  status     InvitationStatus @default(pending) // only one "pending" per (studio, email) — see migration 20260710000100
  expiresAt  DateTime         @map("expires_at")
  invitedBy  String           @map("invited_by") @db.Uuid
  acceptedAt DateTime?        @map("accepted_at")
  revokedAt  DateTime?        @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  role   StudioRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([studioId])
  @@index([studioId, email])
  @@index([studioId, status])
  @@map("invitations")
}

// ═══════════════════════════════════════════════════════════════════════
// BILLING, LICENSING & LIMITS
// ═══════════════════════════════════════════════════════════════════════

/// Global catalog of plans (Starter/Studio/Agency/Enterprise). Not
/// tenant-scoped — every studio picks from the same plan catalog.
/// `features` holds the feature-limit map (see docs/database-conventions.md
/// § "Plan limits & feature flags" for the shape and resolution order).
/// Global catalog of plans (Starter/Professional/Business/Enterprise/
/// Custom). Not tenant-scoped — every studio picks from the same plan
/// catalog. `limits` holds all 16 plan-limit dimensions (users, branches,
/// storage, leads, clients, events, galleries, monthly uploads, AI face
/// searches, AI analysis jobs, WhatsApp messages, email messages, custom
/// domains, white-label access, API access, automation runs) as a single
/// structured JSON object — see @bcp/billing/src/plan-limits.ts for the
/// schema and packages/database/docs/database-conventions.md § "Plan
/// limits" for why this replaced four separate typed columns.
model SubscriptionPlan {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  name        String
  description String?

  priceMonthly Int    @map("price_monthly") // minor units (paise)
  priceYearly  Int    @map("price_yearly")  // minor units (paise)
  currency     String @default("INR")

  limits   Json    @default("{}")
  features Json    @default("{}")
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

/// A studio's subscription to a plan. Rows are kept as history (upgrades,
/// downgrades, renewals) rather than updated in place — the "current" one
/// is the most recent row whose status is not `cancelled`/`expired`. See
/// docs/tenant-isolation.md "Lifecycle states" for the state machine this
/// status field follows (trial → active ⇄ grace/past_due → suspended/
/// expired, or → cancelled at any point).
model Subscription {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  planId   String @map("plan_id") @db.Uuid

  status        SubscriptionStatus @default(trialing)
  billingCycle  BillingCycle       @default(yearly) @map("billing_cycle")
  seats         Int                @default(1)

  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime  @map("ends_at")
  trialEndsAt DateTime? @map("trial_ends_at")
  graceEndsAt DateTime? @map("grace_ends_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  studio      Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  licenseKeys LicenseKey[]
  payments    Payment[]

  @@index([studioId])
  @@index([studioId, status])
  @@map("subscriptions")
}

/// A license key issued to a studio — the artifact platform-admin generates
/// and the studio's deployment (or client app) activates against.
/// `expiresAt` is issuedAt + 1 year for the standard yearly license; see
/// docs/tenant-isolation.md "One-year licenses" for renewal/grace handling.
/// "Allowed studio" is simply `studioId` — a license belongs to exactly
/// one studio, there is no separate field for it. "Allowed domains"
/// restricts which of that studio's verified custom domains this license
/// may be activated against (empty array = no domain restriction).
model LicenseKey {
  id             String  @id @default(uuid()) @db.Uuid
  studioId       String  @map("studio_id") @db.Uuid
  subscriptionId String? @map("subscription_id") @db.Uuid

  key             String        @unique
  tier            String
  status          LicenseStatus @default(active)
  issuedAt        DateTime      @default(now()) @map("issued_at") // start date
  expiresAt       DateTime      @map("expires_at")
  graceEndsAt     DateTime?     @map("grace_ends_at")
  seatsAllowed    Int           @default(1) @map("seats_allowed")
  maxActivations  Int           @default(1) @map("max_activations")
  allowedDomains  String[]      @map("allowed_domains")
  revokedAt       DateTime?     @map("revoked_at")
  revokedReason   String?       @map("revoked_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  studio       Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  activations  Activation[]

  @@index([studioId])
  @@index([studioId, status])
  @@index([expiresAt])
  @@map("license_keys")
}

/// One device/instance activation against a license key. `studioId` is
/// denormalized from `licenseKey.studioId` — required by convention (every
/// studio-scoped model carries studioId directly, see
/// docs/database-conventions.md) and useful on its own for a tenant-scoped
/// "your active devices" query without joining through LicenseKey.
model Activation {
  id           String @id @default(uuid()) @db.Uuid
  licenseKeyId String @map("license_key_id") @db.Uuid
  studioId     String @map("studio_id") @db.Uuid

  fingerprint    String
  hostname       String?
  ipAddress      String?           @map("ip_address")
  deviceMetadata Json?             @map("device_metadata") // OS, app version, device model, etc — freeform, client-supplied
  status         ActivationStatus  @default(active)
  activatedAt    DateTime          @default(now()) @map("activated_at")
  deactivatedAt  DateTime?         @map("deactivated_at")
  lastSeenAt     DateTime?         @map("last_seen_at")

  licenseKey LicenseKey @relation(fields: [licenseKeyId], references: [id], onDelete: Cascade)
  studio     Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([licenseKeyId])
  @@index([licenseKeyId, fingerprint])
  @@map("activations")
}

/// Metered usage per studio per period, for plan-limit enforcement and
/// usage-based billing add-ons. One row per (studio, metric, period).
model UsageRecord {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  metric      String
  value       Decimal  @db.Decimal(18, 4)
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  recordedAt  DateTime @default(now()) @map("recorded_at")
  metadata    Json?

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([studioId, metric, periodStart])
  @@map("usage_records")
}

/// Feature flag with an optional per-studio override. `studioId = null` is
/// the global default; a row with a specific `studioId` overrides it for
/// that studio only. Resolution order is documented in
/// docs/database-conventions.md § "Plan limits & feature flags"; the
/// partial unique indexes that keep `key` unique within each scope are in
/// migration `20260710000100_partial_unique_indexes`.
model FeatureFlag {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String? @map("studio_id") @db.Uuid

  key         String
  name        String?
  description String?
  enabled     Boolean @default(false)
  payload     Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  studio Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([key])
  @@map("feature_flags")
}

// ═══════════════════════════════════════════════════════════════════════
// AUDIT, SESSIONS & OPERATIONS
// ═══════════════════════════════════════════════════════════════════════

/// Append-only audit trail. `studioId` is nullable because some actions are
/// platform-level (e.g. a platform user edits SubscriptionPlan); every
/// studio-level action always sets it. No `updatedAt`/soft-delete — audit
/// rows are immutable by convention (see docs/database-conventions.md).
model AuditLog {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String? @map("studio_id") @db.Uuid

  actorType    ActorType
  actorId      String?   @map("actor_id") @db.Uuid
  action       String
  resourceType String    @map("resource_type")
  resourceId   String?   @map("resource_id")
  metadata     Json?
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  studio Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([resourceType, resourceId])
  @@index([actorType, actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Every login attempt (success or failure) — kept separate from AuditLog
/// so security queries ("show failed logins for this user in the last
/// hour") don't have to filter a much larger, more general table.
model LoginHistory {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String? @map("studio_id") @db.Uuid

  actorType     ActorType
  actorId       String    @map("actor_id") @db.Uuid
  success       Boolean
  failureReason String?   @map("failure_reason")
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  studio Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([actorType, actorId])
  @@index([createdAt])
  @@map("login_history")
}

/// An active (or recently active) login session, keyed off a hashed
/// refresh token — enables "sign out this device" / "sign out everywhere".
model Session {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String? @map("studio_id") @db.Uuid

  actorType         ActorType
  actorId           String    @map("actor_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([actorType, actorId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A studio-issued API key for external integrations. Only the hash and a
/// display prefix are stored — the raw key is shown once at creation time.
model ApiKey {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  name        String
  keyPrefix   String    @map("key_prefix")
  hashedKey   String    @unique @map("hashed_key")
  scopes      String[]
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("api_keys")
}

/// A studio-configured outbound webhook subscription.
model WebhookEndpoint {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  url             String
  secret          String
  events          String[]
  isActive        Boolean   @default(true) @map("is_active")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  lastStatusCode  Int?      @map("last_status_code")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([studioId, isActive])
  @@map("webhook_endpoints")
}

/// An in-app/email/WhatsApp/SMS notification sent to a studio user.
model Notification {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  recipientUserId String              @map("recipient_user_id") @db.Uuid
  channel         NotificationChannel
  title           String
  body            String
  status          NotificationStatus @default(pending)
  readAt          DateTime?           @map("read_at")
  sentAt          DateTime?           @map("sent_at")
  failureReason   String?             @map("failure_reason")
  retryCount      Int                 @default(0) @map("retry_count")
  metadata        Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio        Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  recipientUser StudioUser @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([recipientUserId, status])
  @@index([recipientUserId, readAt])
  @@map("notifications")
}

/// A background job execution record (BullMQ jobs in apps/worker write one
/// of these on start/finish). `studioId` is nullable for platform-wide jobs
/// (e.g. a nightly plan-limit sweep across all studios).
model JobRecord {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String? @map("studio_id") @db.Uuid

  queue       String
  jobName     String    @map("job_name")
  status      JobStatus @default(queued)
  payload     Json?
  result      Json?
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([queue, status])
  @@index([status, createdAt])
  @@map("job_records")
}

// ═══════════════════════════════════════════════════════════════════════
// AUTHENTICATION SUPPORT
// ═══════════════════════════════════════════════════════════════════════

/// A single-use, short-lived hashed token/code backing email verification,
/// password reset, and email-OTP sign-in — structurally identical in all
/// three cases (an actor, a purpose, an expiry, consumed-once), so one
/// table covers all three rather than three near-duplicate ones. See
/// docs/authentication.md § "Verification tokens" for issuance/consumption
/// rules and why a fast hash (not argon2) is appropriate here.
model VerificationToken {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String? @map("studio_id") @db.Uuid // set when actorType = studio_user

  actorType  ActorType
  actorId    String              @map("actor_id") @db.Uuid
  purpose    VerificationPurpose
  tokenHash  String              @map("token_hash")
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  requestIp  String?             @map("request_ip")

  createdAt DateTime @default(now()) @map("created_at")

  studio Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([studioId])
  @@index([actorType, actorId, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
}

/// A 2FA backup code. Ten are generated when 2FA is enabled; each is valid
/// for exactly one use. Hashed the same way as VerificationToken — these
/// are high-entropy random strings, not user-chosen secrets, so a fast
/// hash is the right tool (see docs/authentication.md).
model RecoveryCode {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String? @map("studio_id") @db.Uuid // set when actorType = studio_user

  actorType ActorType
  actorId   String    @map("actor_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  studio Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([codeHash])
  @@index([studioId])
  @@index([actorType, actorId])
  @@map("recovery_codes")
}

// ═══════════════════════════════════════════════════════════════════════
// PLATFORM ADMIN — configuration, announcements, support
// ═══════════════════════════════════════════════════════════════════════

/// Global platform key/value settings (e.g. maintenance-mode flags,
/// default trial length, support contact info shown platform-wide) —
/// the platform-level counterpart to StudioSetting. Not tenant-scoped.
model PlatformSetting {
  id  String @id @default(uuid()) @db.Uuid
  key String @unique

  value Json

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("platform_settings")
}

/// A platform-wide (or plan/studio-targeted) announcement shown as a
/// banner in studio-facing apps — e.g. planned maintenance, a new
/// feature, a billing policy change. `audience = null` means every
/// studio; otherwise a JSON filter (`{ planKeys: [...] }` or
/// `{ studioIds: [...] }`) narrows it. Not tenant-scoped — one
/// announcement can target many studios.
model Announcement {
  id String @id @default(uuid()) @db.Uuid

  title    String
  body     String
  severity AnnouncementSeverity @default(info)
  audience Json?

  isPublished Boolean   @default(false) @map("is_published")
  startsAt    DateTime  @default(now()) @map("starts_at")
  endsAt      DateTime? @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([isPublished, startsAt])
  @@map("announcements")
}

/// A studio's support request to the platform team. Studio-scoped (raised
/// *by* a studio) but visible/assignable on the platform side — this is
/// one of the few models both identity planes legitimately touch, which
/// is why `assignedTo` is a soft-reference `PlatformUser.id` (see
/// docs/database-conventions.md § "Identifiers" for why actor references
/// across the platform/studio boundary are never enforced FKs).
model SupportRequest {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  raisedBy String                  @map("raised_by") @db.Uuid // StudioUser.id
  subject  String
  body     String
  status   SupportRequestStatus   @default(open)
  priority SupportRequestPriority @default(medium)

  assignedTo String?   @map("assigned_to") @db.Uuid // PlatformUser.id, soft-referenced
  resolvedAt DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([status])
  @@index([assignedTo])
  @@map("support_requests")
}

/// A billing transaction attempt against a studio's subscription — the
/// record `payment:view` (platform-admin) and the Payments module render.
/// One row per attempt, not per subscription — a failed retry and its
/// eventual successful charge are two separate rows, so the payment
/// success-rate metric has real attempt-level data to compute from.
model Payment {
  id             String  @id @default(uuid()) @db.Uuid
  studioId       String  @map("studio_id") @db.Uuid
  subscriptionId String? @map("subscription_id") @db.Uuid

  amount            Int // minor units (paise)
  currency          String        @default("INR")
  status            PaymentStatus @default(pending)
  provider          String // "razorpay" | "stripe"
  providerReference String?       @map("provider_reference")
  failureReason     String?       @map("failure_reason")
  paidAt            DateTime?     @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio       Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([studioId])
  @@index([status])
  @@index([studioId, status])
  @@map("payments")
}

// ═══════════════════════════════════════════════════════════════════════
// ONBOARDING
// ═══════════════════════════════════════════════════════════════════════

/// Tracks a studio's progress through the 20-step guided onboarding
/// wizard (see packages/onboarding/docs/onboarding.md for the step
/// registry). `studioId` is nullable because the first two steps (owner
/// account, studio name) happen *before* a real Studio/StudioUser exist —
/// `stepData` stages that pre-provisioning data; once enough is captured,
/// apps/api's onboarding.service.ts provisions the real Studio + owner
/// StudioUser + a trial Subscription + a default StudioBranch in one
/// transaction, sets `studioId`, and every step after that operates on
/// real records via the platform's existing APIs (branding, domains,
/// billing, team) rather than staying in this JSON blob.
model OnboardingSession {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String? @map("studio_id") @db.Uuid

  ownerEmail  String @map("owner_email")
  resumeToken String @unique @map("resume_token") // emailed/bookmarked link lets the owner resume without a full session

  status         OnboardingStatus @default(in_progress)
  currentStep    Int              @default(1) @map("current_step")
  completedSteps String[]         @map("completed_steps")
  skippedSteps   String[]         @map("skipped_steps")
  stepData       Json             @default("{}")

  startedAt      DateTime  @default(now()) @map("started_at")
  lastActivityAt DateTime  @updatedAt @map("last_activity_at")
  completedAt    DateTime? @map("completed_at")

  studio Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([ownerEmail])
  @@map("onboarding_sessions")
}

/// A studio's own client/customer record — intentionally minimal (no
/// booking/quotation relationships yet, since those models don't exist in
/// this phase). Exists specifically to give the onboarding wizard's
/// "Customer import" step somewhere real to write imported rows, and to
/// close the `maxClients` plan-limit dimension that
/// packages/billing/docs/subscription-licensing.md flagged as "reserved —
/// no Client model yet." A full CRM-grade Clients module (booking
/// history, communication log, etc.) is a later phase; this is the seed
/// it will grow from, not a placeholder to be thrown away.
/// A studio's client — expanded in Prompt 14 from the Prompt 9 minimal
/// shape (name/email/phone/source/notes) into a full profile. Mirrors
/// several of Lead's fields deliberately (bride/groom name, Instagram
/// profiles) since a client is very often literally a converted lead
/// (see `Lead.convertedClientId`) and the two should feel like the same
/// person's record, not a re-entry.
model Client {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  name   String
  email  String?
  phone  String?
  source String? // "import" | "manual" | "lead_conversion" | ...
  notes  String?

  brideName String? @map("bride_name")
  groomName String? @map("groom_name")

  instagramProfile1 String? @map("instagram_profile_1")
  instagramProfile2 String? @map("instagram_profile_2")
  facebookProfile   String? @map("facebook_profile")

  billingAddressLine1 String? @map("billing_address_line1")
  billingAddressLine2 String? @map("billing_address_line2")
  billingCity         String? @map("billing_city")
  billingState        String? @map("billing_state")
  billingPostalCode   String? @map("billing_postal_code")
  billingCountry      String? @default("IN") @map("billing_country")

  shippingSameAsBilling Boolean @default(true) @map("shipping_same_as_billing")
  shippingAddressLine1  String? @map("shipping_address_line1")
  shippingAddressLine2  String? @map("shipping_address_line2")
  shippingCity          String? @map("shipping_city")
  shippingState         String? @map("shipping_state")
  shippingPostalCode    String? @map("shipping_postal_code")
  shippingCountry       String? @map("shipping_country")

  gstin        String? // GSTIN, if the client wants GST-compliant invoices themselves (e.g. a corporate client)
  gstLegalName String? @map("gst_legal_name")

  anniversaryDate DateTime? @map("anniversary_date")
  brideBirthday   DateTime? @map("bride_birthday")
  groomBirthday   DateTime? @map("groom_birthday")
  /// Any further dates a studio wants to track beyond the three above —
  /// `[{ "label": "Engagement anniversary", "date": "2025-02-14" }]`.
  otherImportantDates Json? @map("other_important_dates")

  tags String[] @default([])

  referredById   String? @map("referred_by_id") @db.Uuid
  referralNotes  String? @map("referral_notes")

  portalAccessEnabled Boolean   @default(false) @map("portal_access_enabled")
  portalInviteToken   String?   @unique @map("portal_invite_token")
  portalInvitedAt     DateTime? @map("portal_invited_at")
  portalLastLoginAt   DateTime? @map("portal_last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  events Event[]
  quotations Quotation[]
  invoices Invoice[]
  convertedFromLeads Lead[]
  bookings Booking[]
  referredBy    Client?  @relation("ClientReferrals", fields: [referredById], references: [id])
  referrals     Client[] @relation("ClientReferrals")
  familyContacts ClientFamilyContact[]
  communications ClientCommunication[]
  contracts      ClientContract[]
  feedback       ClientFeedback[]
  portalSessions ClientPortalSession[]
  clientSupportRequests ClientSupportRequest[]
  commerceOrders CommerceOrder[]

  @@index([studioId])
  @@index([studioId, deletedAt])
  @@map("clients")
}

// ═══════════════════════════════════════════════════════════════════════
// STUDIO CRM (v1 — minimal models backing the dashboard, Prompt 11)
// ═══════════════════════════════════════════════════════════════════════

/// An enquiry before it becomes a booked Event. Deliberately thin — no
/// scoring, no multi-stage pipeline beyond `status`; a full leads module
/// (source attribution, campaign tracking) is a later phase.
/// A photography enquiry — expanded in Prompt 12 from the Prompt 11 v1
/// shape into the full lead-management field set (wedding-specific
/// fields like bride/groom name reflect this studio's actual shoot mix,
/// per the sample data and marketing copy elsewhere in the product).
model Lead {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid

  name              String
  brideName         String? @map("bride_name")
  groomName         String? @map("groom_name")
  phone             String?
  alternateMobile   String? @map("alternate_mobile")
  email             String?
  instagramProfile1 String? @map("instagram_profile_1")
  instagramProfile2 String? @map("instagram_profile_2")

  eventType String?    @map("event_type")
  eventDate DateTime?  @map("event_date")
  venue     String?
  city      String?

  source             LeadSource   @default(other)
  budget              Int?        // paise — the client's stated budget
  interestedPackage   String?     @map("interested_package")
  notes               String?     // quick free-text; see LeadNote for the timestamped notes thread
  assignedTo          String?     @map("assigned_to") @db.Uuid
  priority            LeadPriority @default(medium)
  status              LeadStatus  @default(new)
  followUpAt          DateTime?   @map("follow_up_at")
  expectedValue       Int?        @map("expected_value") // paise — studio's own estimate, distinct from `budget`
  winProbability      Int?        @map("win_probability") // 0-100, manually set or AI-suggested (see lead-ai.service.ts)
  lostReason          String?     @map("lost_reason")

  convertedClientId String?   @map("converted_client_id") @db.Uuid
  convertedAt        DateTime? @map("converted_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  studio          Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  convertedClient Client?          @relation(fields: [convertedClientId], references: [id])
  events          Event[]
  quotations      Quotation[]
  leadNotes       LeadNote[]
  attachments     LeadAttachment[]
  communications  LeadCommunication[]
  enquiryFormSubmissions EnquiryFormSubmission[]

  @@index([studioId])
  @@index([studioId, status])
  @@index([studioId, followUpAt])
  @@index([studioId, priority])
  @@index([studioId, phone])
  @@index([studioId, email])
  @@map("leads")
}

/// A timestamped note on a lead — distinct from `Lead.notes` (a single
/// quick free-text field): this is the running thread multiple team
/// members add to over the life of an enquiry, and one of the three
/// sources (with AuditLog and LeadCommunication) merged into a lead's
/// Timeline view.
model LeadNote {
  id     String @id @default(uuid()) @db.Uuid
  leadId String @map("lead_id") @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  body String

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([studioId])
  @@map("lead_notes")
}

/// A file attached to a lead (reference photos, a venue brochure, a
/// signed booking form draft) — stored via `@bcp/storage` the same way
/// branding assets are; this table just tracks the pointer + metadata.
model LeadAttachment {
  id     String @id @default(uuid()) @db.Uuid
  leadId String @map("lead_id") @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  fileName String @map("file_name")
  fileKey  String @map("file_key") // storage object key, not a public URL — signed URLs are generated on read
  mimeType String @map("mime_type")
  sizeBytes Int   @map("size_bytes")

  createdAt DateTime @default(now()) @map("created_at")
  uploadedBy String? @map("uploaded_by") @db.Uuid

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([studioId])
  @@map("lead_attachments")
}

enum CommunicationChannel {
  call
  email
  whatsapp
  sms
  meeting
  other
}

enum CommunicationDirection {
  inbound
  outbound
}

/// A logged interaction with a lead — the "Communication history"
/// feature. Manually logged in this phase (call notes, a meeting
/// summary); auto-logging from real email/WhatsApp/call integrations is
/// future scope, same as the onboarding wizard's payment-gateway step
/// only recording a preference rather than a live OAuth connection.
model LeadCommunication {
  id     String @id @default(uuid()) @db.Uuid
  leadId String @map("lead_id") @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  channel   CommunicationChannel
  direction CommunicationDirection
  summary   String
  occurredAt DateTime @map("occurred_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([studioId])
  @@map("lead_communications")
}

/// A scheduled shoot. Bridges lead → booking → completed shoot via
/// `status`; `editingStatus` tracks post-production separately since it
/// progresses independently of the booking lifecycle.
/// Expanded in Prompt 18 with the full shoot-day detail set: venue and
/// map location, a contact person on the ground (often not the client
/// themselves — a wedding planner, a family member), dress/travel/
/// accommodation notes, and per-event deliverables (distinct from
/// `Booking.deliverables`, since one booking's several events can
/// deliver different things — an engagement shoot's turnaround differs
/// from the wedding day's). `eventType` stays a free-text field (not a
/// DB enum) for consistency with `Lead.eventType`/`Package.eventType`,
/// which are already free text — `@bcp/events`' `EVENT_TYPES` offers the
/// 13 standard options as picker suggestions, the same "seed data, not a
/// fixture" relationship `@bcp/catalog`'s `DEFAULT_SERVICES` has to
/// `Service`.
model Event {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid
  clientId String? @map("client_id") @db.Uuid
  leadId   String? @map("lead_id") @db.Uuid
  bookingId String? @map("booking_id") @db.Uuid

  title         String
  eventType     String        @map("event_type")
  status        EventStatus   @default(enquiry)
  editingStatus EditingStatus @default(not_started) @map("editing_status")
  scheduledAt   DateTime      @map("scheduled_at")
  endAt         DateTime?     @map("end_at")
  location      String?

  venue             String?
  addressLine1      String?   @map("address_line1")
  addressCity       String?   @map("address_city")
  addressState      String?   @map("address_state")
  addressPostalCode String?   @map("address_postal_code")
  latitude          Float?
  longitude         Float?

  contactPersonName  String? @map("contact_person_name")
  contactPersonPhone String? @map("contact_person_phone")

  dressNotes          String? @map("dress_notes")
  travelNotes          String? @map("travel_notes")
  accommodationNotes   String? @map("accommodation_notes")
  internalNotes        String? @map("internal_notes")

  deliverables String[] @default([])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  studio      Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client      Client?           @relation(fields: [clientId], references: [id])
  lead        Lead?             @relation(fields: [leadId], references: [id])
  booking     Booking?          @relation(fields: [bookingId], references: [id])
  assignments EventAssignment[]
  quotations  Quotation[]
  invoices    Invoice[]
  galleries   Gallery[]
  albums      Album[]
  contracts   ClientContract[]
  deliveries  Delivery[]
  feedback    ClientFeedback[]
  equipment       EventEquipment[]
  services        EventService[]
  shotListItems   EventShotListItem[]
  scheduleItems   EventScheduleItem[]
  workflowInstances WorkflowInstance[]
  tasks             Task[]
  freelancerPayments FreelancerPayment[]
  equipmentCheckoutRecords EquipmentCheckoutRecord[]
  expenses Expense[]
  eventProductPricing EventProductPricing[]
  commerceOrders      CommerceOrder[]

  @@index([studioId])
  @@index([studioId, status])
  @@index([studioId, scheduledAt])
  @@index([studioId, editingStatus])
  @@index([bookingId])
  @@map("events")
}

/// Which team members are working a given shoot — the basis for the
/// "Team availability" widget (busy = assigned to an event in the
/// relevant window; everyone else on an active roster is available).
model EventAssignment {
  id            String  @id @default(uuid()) @db.Uuid
  eventId       String  @map("event_id") @db.Uuid
  studioUserId  String  @map("studio_user_id") @db.Uuid
  role          String?

  createdAt DateTime @default(now()) @map("created_at")

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)

  @@unique([eventId, studioUserId])
  @@index([studioUserId])
  @@map("event_assignments")
}

/// Expanded in Prompt 16 from the Prompt 11 v1 shape (subtotal/gst/total
/// only, no line items) into a full quotation: optionally built from a
/// `Package` (line items and payment schedule are snapshotted onto the
/// quotation at creation — see `QuotationLineItem`/
/// `QuotationPaymentScheduleItem` — so editing the source Package later
/// never rewrites a quotation already sent), with its own discount,
/// public share link, view tracking, and revision history.
model Quotation {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid
  clientId String? @map("client_id") @db.Uuid
  leadId   String? @map("lead_id") @db.Uuid
  eventId  String? @map("event_id") @db.Uuid
  packageId String? @map("package_id") @db.Uuid

  quotationNumber String          @map("quotation_number")
  status          QuotationStatus @default(draft)

  subtotal    Int // paise — sum of line items before discount/tax
  discountType   QuotationDiscountType? @map("discount_type")
  discountValue  Float?                 @map("discount_value") // percentage points or paise, per discountType
  discountAmount Int                    @default(0) @map("discount_amount") // paise, resolved
  gstRatePercent Float                  @default(0) @map("gst_rate_percent")
  gstAmount      Int                    @default(0) @map("gst_amount")
  totalAmount    Int                    @map("total_amount") // customer-facing total: subtotal - discount + gst
  internalCost   Int                    @default(0) @map("internal_cost") // paise, studio-only — never rendered on any customer-facing output
  itemLevelPricingEnabled Boolean @default(false) @map("item_level_pricing_enabled") // same rule as Package — off by default, defaults from the source Package if built from one

  termsText   String?   @map("terms_text")
  validUntil  DateTime? @map("valid_until")

  publicToken   String    @unique @map("public_token")
  viewCount     Int       @default(0) @map("view_count")
  lastViewedAt  DateTime? @map("last_viewed_at")
  respondedAt   DateTime? @map("responded_at")
  convertedAt   DateTime? @map("converted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio  Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id])
  lead    Lead?    @relation(fields: [leadId], references: [id])
  event   Event?   @relation(fields: [eventId], references: [id])
  package Package? @relation(fields: [packageId], references: [id])

  lineItems       QuotationLineItem[]
  paymentSchedule QuotationPaymentScheduleItem[]
  revisions       QuotationRevision[]
  views           QuotationView[]
  approvals       QuotationApproval[]
  accessCodes     QuotationAccessCode[]
  booking         Booking?
  invoices        Invoice[]

  @@unique([studioId, quotationNumber])
  @@index([studioId])
  @@index([studioId, status])
  @@index([studioId, validUntil])
  @@map("quotations")
}

/// A snapshotted service or add-on line on a quotation — copied from
/// `Service`/`PackageService`/`PackageAddOn` at the moment it's added
/// (or when a quotation is built from a Package), never a live
/// reference, so a quotation already sent to a client is immutable
/// history even if the underlying catalog changes afterward.
model QuotationLineItem {
  id          String                 @id @default(uuid()) @db.Uuid
  quotationId String                 @map("quotation_id") @db.Uuid
  kind        QuotationLineItemKind  @default(service)

  name          String
  quantity      Int    @default(1)
  unitPrice     Int    @map("unit_price") // paise — customer-facing for add-ons; internal-cost basis for services (see Quotation.internalCost)
  internalPrice Int?   @map("internal_price") // paise, services only — the studio's own cost for this line, never customer-facing

  order Int @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_line_items")
}

model QuotationPaymentScheduleItem {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @map("quotation_id") @db.Uuid

  label      String
  percentage Float
  amount     Int    // paise, resolved from percentage × totalAmount at snapshot time
  trigger    PaymentScheduleTrigger @default(on_booking)
  order      Int    @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_payment_schedule_items")
}

/// A full snapshot of a quotation's customer-facing content at the
/// moment of a meaningful edit — "Revision history." Stores the
/// rendered state (`snapshot` JSON), not a diff, so viewing any past
/// revision never depends on replaying changes in order.
model QuotationRevision {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @map("quotation_id") @db.Uuid
  studioId    String @map("studio_id") @db.Uuid

  revisionNumber Int  @map("revision_number")
  snapshot       Json
  changeSummary  String? @map("change_summary")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([quotationId, revisionNumber])
  @@index([studioId])
  @@map("quotation_revisions")
}

/// One row per time the public quotation link is opened — "View
/// tracking" and "IP and timestamp audit" are the same record, not two
/// separate features: every view already carries both.
model QuotationView {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @map("quotation_id") @db.Uuid
  studioId    String @map("studio_id") @db.Uuid

  viewedAt  DateTime @default(now()) @map("viewed_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([studioId])
  @@map("quotation_views")
}

/// The client's accept/reject decision — "Digital approval." Captures
/// the same audit facts a view does (IP, timestamp, user agent) plus
/// the typed name used as a lightweight e-signature and whether OTP
/// verification gated this specific action.
model QuotationApproval {
  id          String                  @id @default(uuid()) @db.Uuid
  quotationId String                  @map("quotation_id") @db.Uuid
  studioId    String                  @map("studio_id") @db.Uuid

  action        QuotationApprovalAction
  signedByName  String?                 @map("signed_by_name")
  rejectionReason String?               @map("rejection_reason")
  otpVerified   Boolean                 @default(false) @map("otp_verified")
  ipAddress     String?                 @map("ip_address")
  userAgent     String?                 @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([studioId])
  @@map("quotation_approvals")
}

/// A one-time code issued for OTP-gated access to a quotation's public
/// link — scoped directly to the quotation (not to any StudioUser/
/// PlatformUser actor), since the recipient is a lead or client who may
/// have no platform account at all. `codeHash` follows the same
/// hash-never-store-plaintext convention as `VerificationToken`.
model QuotationAccessCode {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @map("quotation_id") @db.Uuid

  codeHash   String    @map("code_hash")
  target     String    // the email or phone the code was sent to
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  requestIp  String?   @map("request_ip")

  createdAt DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_access_codes")
}

/// Expanded in Prompt 23 from the Prompt 11 minimal shape
/// (invoiceNumber/status/subtotal/gstAmount/totalAmount) into the full
/// billing document. `documentType` covers the three invoice-shaped
/// documents named in the brief (proforma/tax/non-GST) — Receipt,
/// CreditNote, and RefundReceipt are separate models below since they
/// aren't invoices at all, just documents that reference one.
/// `invoiceNumber` is generated respecting branch and financial-year
/// numbering (see `@bcp/billing`'s `buildDocumentNumber()`), not a
/// flat incrementing count like earlier simpler documents
/// (Quotation/Booking/PurchaseOrder numbers) — GST compliance in India
/// specifically expects invoice sequences to reset (or at least be
/// traceable) per financial year.
model Invoice {
  id          String  @id @default(uuid()) @db.Uuid
  studioId    String  @map("studio_id") @db.Uuid
  branchId    String? @map("branch_id") @db.Uuid
  clientId    String? @map("client_id") @db.Uuid
  eventId     String? @map("event_id") @db.Uuid
  quotationId String? @map("quotation_id") @db.Uuid

  documentType  InvoiceDocumentType @default(tax_invoice) @map("document_type")
  invoiceNumber String              @map("invoice_number")
  financialYear String              @map("financial_year") // "2026-27" — the Indian FY the number was issued under
  status        InvoiceStatus       @default(unpaid)

  subtotal    Int // paise, before discount/tax
  discountType   InvoiceDiscountType? @map("discount_type")
  discountValue  Float?               @map("discount_value")
  discountAmount Int                  @default(0) @map("discount_amount")

  isInterState Boolean @default(false) @map("is_inter_state") // determines CGST+SGST (false) vs IGST (true) split
  gstRatePercent Float @default(0) @map("gst_rate_percent")
  gstAmount   Int @default(0) @map("gst_amount") // total GST — cgstAmount+sgstAmount, or igstAmount
  cgstAmount  Int @default(0) @map("cgst_amount")
  sgstAmount  Int @default(0) @map("sgst_amount")
  igstAmount  Int @default(0) @map("igst_amount")

  totalAmount Int       @map("total_amount")
  amountPaid  Int       @default(0) @map("amount_paid")
  dueDate     DateTime? @map("due_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio    Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id])
  event     Event?     @relation(fields: [eventId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])
  payments  ClientPayment[]
  installments InvoiceInstallment[]
  creditNotes  CreditNote[]

  @@unique([studioId, invoiceNumber])
  @@index([studioId])
  @@index([studioId, status])
  @@index([studioId, dueDate])
  @@map("invoices")
}

/// The invoice's own payment plan — "Installments" — distinct from the
/// `ClientPayment` rows that record money actually received. Mirrors
/// `QuotationPaymentScheduleItem`/`BookingPaymentScheduleItem`'s
/// shape, the third appearance of the same pattern at a different
/// stage of the client-facing pipeline.
model InvoiceInstallment {
  id        String @id @default(uuid()) @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid

  label      String
  dueDate    DateTime           @map("due_date")
  amount     Int // paise
  status     InstallmentStatus  @default(pending)
  order      Int                @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_installments")
}

/// A single payment transaction against an invoice — an invoice can
/// have several (deposit, balance) before it's fully paid.
/// Every payment automatically generates a `Receipt` — see `receipt`
/// below, created in the same transaction as the payment itself
/// (`apps/api`'s `recordPayment()`), never as an optional follow-up
/// step a studio has to remember to do.
model ClientPayment {
  id        String        @id @default(uuid()) @db.Uuid
  studioId  String        @map("studio_id") @db.Uuid
  invoiceId String        @map("invoice_id") @db.Uuid
  amount    Int // paise
  method    PaymentMethod @default(other)
  paidAt    DateTime      @map("paid_at")
  notes     String?
  recordedBy String?      @map("recorded_by") @db.Uuid

  gatewayProvider      String? @map("gateway_provider") // "razorpay" | "cashfree", when method is one of those
  gatewayTransactionId String? @map("gateway_transaction_id")

  createdAt DateTime @default(now()) @map("created_at")

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receipt Receipt?
  refundReceipts RefundReceipt[]

  @@index([studioId])
  @@index([invoiceId])
  @@map("client_payments")
}

/// Delivery-pipeline status for a shoot's gallery — not the gallery
/// product itself (upload, watermarking, face search are a dedicated
/// later phase); just enough to track and surface where a shoot's
/// gallery stands.
/// Expanded in Prompt 26 from the Prompt 11 "status tracker" shape
/// into the real public gallery product — the studio-facing settings
/// record; `GalleryPhoto` holds the actual images. `publicToken` is
/// the unique link, resolved by `apps/gallery-web`'s public routes the
/// same way `Quotation.publicToken` is resolved by the client portal —
/// opaque, not the gallery's own UUID, so a shared link doesn't leak
/// an internal database ID.
model Gallery {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid
  eventId  String  @map("event_id") @db.Uuid

  status      GalleryStatus @default(pending_upload)
  photoCount  Int           @default(0) @map("photo_count")
  deliveredAt DateTime?     @map("delivered_at")

  publicToken String  @unique @default(uuid()) @map("public_token")
  title       String?
  description String?
  layout      GalleryLayout @default(grid)
  coverPhotoId String? @map("cover_photo_id") @db.Uuid

  passwordHash String?   @map("password_hash") // set = password-gated
  otpRequired  Boolean   @default(false) @map("otp_required") // gated by a one-time code sent to the guest's phone/email instead of/in addition to a password
  expiresAt    DateTime? @map("expires_at")
  guestAccessEnabled Boolean @default(true) @map("guest_access_enabled") // whether a guest (non-StudioUser) can favorite/comment at all, vs. view-only

  allowOriginalDownload   Boolean @default(true) @map("allow_original_download")
  allowCompressedDownload Boolean @default(true) @map("allow_compressed_download")
  downloadLimitPerGuest   Int?    @map("download_limit_per_guest") // null = unlimited

  watermarkEnabled Boolean @default(false) @map("watermark_enabled")
  watermarkText    String? @map("watermark_text")

  faceSearchEnabled              Boolean @default(false) @map("face_search_enabled")
  faceSearchConfidenceThreshold  Int     @default(90) @map("face_search_confidence_threshold") // 0-100, AWS Rekognition's own scale
  faceSearchRetentionDays        Int     @default(30) @map("face_search_retention_days") // how long a FaceSearchSession's record (never the selfie itself, which is deleted immediately) is kept before purge

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  photos        GalleryPhoto[]
  accessSessions GalleryAccessSession[]
  favorites     GalleryFavorite[]
  comments      GalleryComment[]
  downloadLogs  GalleryDownloadLog[]
  uploadSessions UploadSession[]
  faceCollection     FaceCollection?
  faceSearchSessions FaceSearchSession[]
  faceConsentLogs    FaceConsentLog[]
  cullingSessions   CullingSession[]
  albumSuggestions  AlbumSuggestion[]
  duplicateGroups    DuplicateGroup[]
  albumsSelectingFrom Album[]
  commerceOrders CommerceOrder[]

  @@index([studioId])
  @@index([studioId, status])
  @@map("galleries")
}

/// One uploaded photo. `fileKey`/`compressedKey`/`watermarkedKey` are
/// all `@bcp/storage` object keys for the same image at different
/// processing stages — never three separate uploads, one source file
/// with derived variants. Which variant a request actually gets back
/// is resolved by `@bcp/gallery`'s `resolvePhotoVariant()` based on the
/// gallery's watermark/download settings and who's asking (a studio
/// user always sees the true original; a guest sees whatever the
/// gallery's settings allow).
model GalleryPhoto {
  id        String @id @default(uuid()) @db.Uuid
  galleryId String @map("gallery_id") @db.Uuid
  studioId  String @map("studio_id") @db.Uuid

  fileKey         String  @map("file_key") // original, full resolution
  compressedKey   String? @map("compressed_key") // web-optimized variant
  thumbnailKey    String? @map("thumbnail_key")
  previewKey      String? @map("preview_key") // medium-size variant for the lightbox — distinct from the thumbnail grid size and the full compressed download
  watermarkedKey  String? @map("watermarked_key") // pre-rendered watermarked variant, when watermarkEnabled

  checksum        String? // SHA-256 of the original file — duplicate detection within a gallery
  exifData        Json?   @map("exif_data")
  blurPlaceholder String? @map("blur_placeholder") // tiny base64 data URI shown while the real image loads

  width  Int?
  height Int?

  category String? // free text — same "studio-defined, not a fixed enum" convention as Event.eventType/Equipment.category
  order    Int     @default(0)
  isHidden Boolean @default(false) @map("is_hidden") // uploaded but not shown to guests — e.g. a studio's own reference shots

  uploadedAt DateTime @default(now()) @map("uploaded_at")
  uploadedBy String?  @map("uploaded_by") @db.Uuid

  gallery      Gallery              @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  studio       Studio               @relation(fields: [studioId], references: [id], onDelete: Cascade)
  favorites    GalleryFavorite[]
  comments     GalleryComment[]
  downloadLogs GalleryDownloadLog[]
  faceIndexEntries FaceIndexEntry[]
  faceSearchMatches FaceSearchMatch[]
  cullingRecommendations CullingRecommendation[]
  commerceOrderItems     CommerceOrderItem[]
  albumSuggestionPhotos  AlbumSuggestionPhoto[]
  albumSelectionItems    AlbumSelectionItem[]
  albumSelectionHistory  AlbumSelectionHistory[]
  photoAnalysis PhotoAnalysis?
  duplicateGroupMemberships DuplicateGroupMember[]

  @@unique([galleryId, checksum])
  @@index([galleryId])
  @@index([galleryId, isHidden])
  @@index([studioId])
  @@map("gallery_photos")
}

/// A guest's verified access to a password/OTP-gated gallery.
/// `guestToken` is an opaque value the gallery-web frontend stores
/// client-side (a cookie/localStorage value, not a login) — the same
/// "session without an account" pattern
/// `QuotationAccessCode`/`QuotationApproval` already established for
/// public quotation approval in Prompt 16. `otpCode`/`otpExpiresAt`
/// are only populated when the gallery requires OTP.
model GalleryAccessSession {
  id        String @id @default(uuid()) @db.Uuid
  galleryId String @map("gallery_id") @db.Uuid

  guestToken String  @unique @map("guest_token")
  guestName  String? @map("guest_name")
  guestPhone String? @map("guest_phone")
  guestEmail String? @map("guest_email")

  passwordVerified Boolean   @default(false) @map("password_verified")
  otpCode          String?   @map("otp_code")
  otpExpiresAt     DateTime? @map("otp_expires_at")
  otpVerified      Boolean   @default(false) @map("otp_verified")

  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId])
  @@map("gallery_access_sessions")
}

model GalleryFavorite {
  id        String @id @default(uuid()) @db.Uuid
  galleryId String @map("gallery_id") @db.Uuid
  photoId   String @map("photo_id") @db.Uuid

  guestToken String @map("guest_token")

  createdAt DateTime @default(now()) @map("created_at")

  gallery Gallery      @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photo   GalleryPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, guestToken])
  @@index([galleryId])
  @@map("gallery_favorites")
}

model GalleryComment {
  id        String  @id @default(uuid()) @db.Uuid
  galleryId String  @map("gallery_id") @db.Uuid
  photoId   String? @map("photo_id") @db.Uuid // null = a gallery-level comment, not tied to one photo

  guestToken String  @map("guest_token")
  guestName  String  @map("guest_name")
  body       String

  createdAt DateTime @default(now()) @map("created_at")

  gallery Gallery       @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photo   GalleryPhoto? @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([galleryId])
  @@index([photoId])
  @@map("gallery_comments")
}

/// "Download tracking" — every original/compressed download a guest
/// makes creates one row, which is also what
/// `downloadLimitPerGuest` counts against.
model GalleryDownloadLog {
  id        String  @id @default(uuid()) @db.Uuid
  galleryId String  @map("gallery_id") @db.Uuid
  photoId   String? @map("photo_id") @db.Uuid // null = a "download all" bulk action

  guestToken   String              @map("guest_token")
  downloadType GalleryDownloadType @map("download_type")

  downloadedAt DateTime @default(now()) @map("downloaded_at")

  gallery Gallery       @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photo   GalleryPhoto? @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([galleryId])
  @@index([galleryId, guestToken])
  @@map("gallery_download_logs")
}

/// Album pipeline status for a shoot — selection → design → print, same
/// "status tracker, not full workflow" scope as Gallery above.
/// Expanded in Prompt 31 from the Prompt 11 status tracker into the
/// real client-facing selection experience. `sourceGalleryId` points
/// at the delivered `Gallery` whose photos are the selectable pool —
/// selection is deliberately a separate workflow from gallery viewing
/// itself (Prompt 26), since a client picking album photos and a guest
/// browsing/favoriting/downloading are different audiences with
/// different rules (a selection has a limit and a deadline; a gallery
/// view doesn't).
model Album {
  id      String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  eventId String @map("event_id") @db.Uuid
  sourceGalleryId String? @map("source_gallery_id") @db.Uuid

  status AlbumStatus @default(pending_selection)

  publicToken String  @unique @default(uuid()) @map("public_token")
  otpRequired Boolean @default(true) @map("otp_required")

  selectionLimit Int? @map("selection_limit") // overall cap across the whole album; null = unlimited

  deadline    DateTime? @map("deadline")
  lockedAt    DateTime? @map("locked_at") // set on submit — see AlbumSelectionItem's doc comment for what "locked" actually blocks
  reopenedAt  DateTime? @map("reopened_at") // studio re-opening a locked selection; clears on the next lock
  submittedAt DateTime? @map("submitted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  designerId         String?   @map("designer_id") @db.Uuid
  designerAssignedAt DateTime? @map("designer_assigned_at")

  productionStage AlbumProductionStage @default(photos_selected) @map("production_stage")

  revisionLimit Int? @map("revision_limit") // max free revision rounds; null = unlimited

  fullyApprovedAt         DateTime? @map("fully_approved_at")
  fullyApprovedByGuestToken String? @map("fully_approved_by_guest_token")

  eAlbumToken           String?  @unique @map("e_album_token") // separate from the selection link's publicToken — a different link, delivered at a different lifecycle stage
  eAlbumPasswordHash    String?  @map("e_album_password_hash")
  eAlbumOtpRequired     Boolean  @default(false) @map("e_album_otp_required")
  eAlbumDownloadEnabled Boolean  @default(true) @map("e_album_download_enabled")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sourceGallery Gallery? @relation(fields: [sourceGalleryId], references: [id])
  designer StudioUser? @relation(fields: [designerId], references: [id])
  printOrders PrintOrder[]
  categoryLimits  AlbumCategoryLimit[]
  selectionItems  AlbumSelectionItem[]
  selectionHistory AlbumSelectionHistory[]
  accessSessions  AlbumAccessSession[]
  spreads         AlbumSpread[]
  revisionRequests AlbumRevisionRequest[]
  eAlbumAccessSessions EAlbumAccessSession[]

  @@index([studioId])
  @@index([studioId, status])
  @@map("albums")
}

/// "Category limits" — a per-category cap on top of `Album.selectionLimit`'s
/// overall one, e.g. "at most 5 getting-ready shots, at most 15
/// reception shots" within a 40-photo album. `category` matches
/// `GalleryPhoto.category` — free text, not a fixed enum, the same
/// convention that field already uses.
model AlbumCategoryLimit {
  id      String @id @default(uuid()) @db.Uuid
  albumId String @map("album_id") @db.Uuid

  category   String
  limitCount Int    @map("limit_count")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, category])
  @@index([albumId])
  @@map("album_category_limits")
}

enum AlbumSelectionStatus {
  pending
  selected
  rejected
}

/// One photo's state within one client's album selection.
/// `isFavorite` is intentionally independent of `status` — a client
/// can favorite a photo as a personal shortlist marker without it
/// counting toward the selection limit, and can select a photo without
/// favoriting it; the brief lists them as separate actions because
/// they answer different questions ("do I love this" vs. "is this
/// going in the album"). Locking (`Album.lockedAt` being set) is
/// enforced in `apps/api`, not the schema — the same "structural rule
/// lives in the service layer, not a DB constraint" choice made for
/// every other single-pointer/exclusive-state rule in this codebase.
model AlbumSelectionItem {
  id      String @id @default(uuid()) @db.Uuid
  albumId String @map("album_id") @db.Uuid
  galleryPhotoId String @map("gallery_photo_id") @db.Uuid

  status     AlbumSelectionStatus @default(pending)
  isFavorite Boolean              @default(false) @map("is_favorite")
  comment    String?

  guestToken String   @map("guest_token")
  updatedAt  DateTime @updatedAt @map("updated_at")

  album        Album        @relation(fields: [albumId], references: [id], onDelete: Cascade)
  galleryPhoto GalleryPhoto @relation(fields: [galleryPhotoId], references: [id], onDelete: Cascade)

  @@unique([albumId, galleryPhotoId])
  @@index([albumId])
  @@index([albumId, status])
  @@map("album_selection_items")
}

enum AlbumSelectionAction {
  selected
  deselected
  favorited
  unfavorited
  rejected
  commented
  submitted
  locked
  reopened
}

/// "Selection history" — an append-only log of every action a client
/// (or, for lock/reopen, the studio) takes, independent of
/// `AlbumSelectionItem`'s current-state row. A photo can be selected,
/// deselected, and reselected several times before submission; the
/// current state only shows where it landed, this is the full story of
/// how it got there.
model AlbumSelectionHistory {
  id      String  @id @default(uuid()) @db.Uuid
  albumId String  @map("album_id") @db.Uuid
  galleryPhotoId String? @map("gallery_photo_id") @db.Uuid // null for album-level actions (submitted/locked/reopened)

  action     AlbumSelectionAction
  guestToken String?              @map("guest_token") // null when the actor is the studio (e.g. reopening)
  actorType  String               @map("actor_type") // "client" | "studio"

  createdAt DateTime @default(now()) @map("created_at")

  album        Album         @relation(fields: [albumId], references: [id], onDelete: Cascade)
  galleryPhoto GalleryPhoto? @relation(fields: [galleryPhotoId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@index([albumId, createdAt])
  @@map("album_selection_history")
}

/// A client's verified access to the selection link — the same
/// "opaque guest token, persisted client-side, no account required"
/// shape `GalleryAccessSession` already established, kept as its own
/// model rather than reused directly since an album selection session
/// and a gallery-viewing session are answering different access
/// questions even when the same person holds both.
model AlbumAccessSession {
  id      String @id @default(uuid()) @db.Uuid
  albumId String @map("album_id") @db.Uuid

  guestToken String  @unique @map("guest_token")
  guestName  String? @map("guest_name")
  guestPhone String? @map("guest_phone")
  guestEmail String? @map("guest_email")

  otpCode      String?   @map("otp_code")
  otpExpiresAt DateTime? @map("otp_expires_at")
  otpVerified  Boolean   @default(false) @map("otp_verified")

  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@map("album_access_sessions")
}

/// Expanded in Prompt 22 from the Prompt 11 minimal shape
/// (category/amount/incurredOn) into a full expense record. An
/// "event expense" vs. a "general expense" isn't a separate field —
/// it's simply whether `eventId`/`bookingId` is set, the same
/// optional-FK convention used throughout rather than a redundant
/// type flag that could disagree with the FK itself.
model Expense {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid
  eventId  String? @map("event_id") @db.Uuid
  bookingId String? @map("booking_id") @db.Uuid
  vendorId  String? @map("vendor_id") @db.Uuid
  costCentreId String? @map("cost_centre_id") @db.Uuid
  purchaseOrderId String? @map("purchase_order_id") @db.Uuid
  vendorBillId    String? @map("vendor_bill_id") @db.Uuid

  category   ExpenseCategory
  amount     Int // paise
  gstAmount  Int             @default(0) @map("gst_amount")
  tdsAmount  Int             @default(0) @map("tds_amount")
  incurredOn DateTime        @map("incurred_on")
  notes      String?

  receiptFileKey String? @map("receipt_file_key")

  approvalStatus ExpenseApprovalStatus @default(not_required) @map("approval_status")
  approvedByUserId String?             @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?           @map("approved_at")

  paymentStatus ExpensePaymentStatus @default(unpaid) @map("payment_status")

  isRecurring         Boolean              @default(false) @map("is_recurring")
  recurrenceFrequency RecurrenceFrequency? @map("recurrence_frequency")
  recurrenceInterval  Int?                 @map("recurrence_interval")
  nextOccurrenceAt    DateTime?            @map("next_occurrence_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio        Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  event         Event?          @relation(fields: [eventId], references: [id])
  booking       Booking?        @relation(fields: [bookingId], references: [id])
  vendor        Vendor?         @relation(fields: [vendorId], references: [id])
  costCentre    CostCentre?     @relation(fields: [costCentreId], references: [id])
  purchaseOrder PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  vendorBill    VendorBill?     @relation(fields: [vendorBillId], references: [id])

  @@index([studioId])
  @@index([studioId, incurredOn])
  @@index([studioId, eventId])
  @@index([studioId, approvalStatus])
  @@map("expenses")
}

/// Per-user dashboard customization — widget visibility and order. One
/// row per StudioUser (not per studio), since two people on the same
/// studio may want different widgets front and center.
model DashboardPreference {
  id           String @id @default(uuid()) @db.Uuid
  studioId     String @map("studio_id") @db.Uuid
  studioUserId String @unique @map("studio_user_id") @db.Uuid

  /// Ordered array of `{ key, visible }` — see packages/dashboard's
  /// `DashboardLayout` type, which this JSON is validated against.
  layout Json @default("[]")

  updatedAt DateTime @updatedAt @map("updated_at")

  studio     Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("dashboard_preferences")
}

// ═══════════════════════════════════════════════════════════════════════
// PUBLIC ENQUIRY FORM (Prompt 13)
// ═══════════════════════════════════════════════════════════════════════

/// A studio-configurable public enquiry form. A studio can have more
/// than one (e.g. a wedding-specific form and a general one) — each
/// gets its own public link, embed code, and QR. Resolved publicly by
/// `(studioSlug, slug)`, the same pattern `/public/branding` already
/// uses for hostname-independent public access (see
/// resolve-studio-for-auth.ts) rather than requiring a custom domain.
model EnquiryForm {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid

  slug        String
  title       String
  description String?
  coverImageUrl String? @map("cover_image_url")

  /// Which of the standard Lead fields to show/require, beyond the
  /// hardcoded always-required `name` — e.g. `{"phone": "required",
  /// "email": "optional", "budget": "hidden"}`. Validated against
  /// `@bcp/enquiry-form`'s `formFieldsConfigSchema` on every write.
  formFieldsConfig Json @default("{}") @map("form_fields_config")
  eventTypes       String[] @map("event_types")
  contactMethods   PreferredContactMethod[] @map("contact_methods")

  consentRequired Boolean @default(true) @map("consent_required")
  consentText     String  @default("I agree to be contacted about my enquiry.") @map("consent_text")
  termsUrl        String? @map("terms_url")
  termsText       String? @map("terms_text")

  successMessage       String  @default("Thanks — we've received your enquiry and will be in touch shortly.") @map("success_message")
  autoResponseEnabled  Boolean @default(true) @map("auto_response_enabled")
  autoResponseMessage  String? @map("auto_response_message")
  defaultAssignedTo    String? @map("default_assigned_to") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio      Studio                @relation(fields: [studioId], references: [id], onDelete: Cascade)
  submissions EnquiryFormSubmission[]

  @@unique([studioId, slug])
  @@index([studioId])
  @@map("enquiry_forms")
}

/// One row per public submission — kept distinct from the `Lead` it
/// creates because a submission carries facts about the *event*
/// (marketing attribution, consent proof, spam signals, the raw
/// as-submitted payload) that don't belong on the CRM record itself,
/// and because a submission can exist even when lead creation is
/// rejected (spam/rate-limited), which is useful to keep visibility
/// into for tuning the form's spam protection later.
model EnquiryFormSubmission {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  formId   String @map("form_id") @db.Uuid
  leadId   String? @map("lead_id") @db.Uuid

  payload Json // raw as-submitted field values

  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmTerm     String? @map("utm_term")
  utmContent  String? @map("utm_content")
  referrer    String?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  consentGiven         Boolean  @default(false) @map("consent_given")
  consentTextSnapshot  String?  @map("consent_text_snapshot")

  isDuplicate  Boolean @default(false) @map("is_duplicate")
  spamFlagged  Boolean @default(false) @map("spam_flagged")
  spamReason   String? @map("spam_reason")

  createdAt DateTime @default(now()) @map("created_at")

  studio Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  form   EnquiryForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  lead   Lead?        @relation(fields: [leadId], references: [id])

  @@index([studioId])
  @@index([formId])
  @@index([studioId, createdAt])
  @@map("enquiry_form_submissions")
}

// ═══════════════════════════════════════════════════════════════════════
// CLIENT CRM (Prompt 14)
// ═══════════════════════════════════════════════════════════════════════

/// A family member or other contact associated with a client — a
/// parent booking on a couple's behalf, a wedding planner, a second
/// point of contact. Deliberately simple (no portal access of its own,
/// no separate communication log) since these are secondary contacts,
/// not full client records.
model ClientFamilyContact {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @map("client_id") @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  name         String
  relationship String? // "Mother", "Wedding planner", ...
  phone        String?
  email        String?

  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([studioId])
  @@map("client_family_contacts")
}

/// A logged interaction with a client — same shape and same "manually
/// logged in this phase" scope as `LeadCommunication`, kept as its own
/// table rather than reusing that one directly since a lead and the
/// client it converts into are different records with different
/// lifecycles (a lead's communication history doesn't disappear when it
/// converts, and a client can accumulate its own from that point on).
model ClientCommunication {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @map("client_id") @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  channel    CommunicationChannel
  direction  CommunicationDirection
  summary    String
  occurredAt DateTime @map("occurred_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([studioId])
  @@map("client_communications")
}

/// A booking contract — status-tracked, not a full e-signature
/// workflow. `fileKey` points at a `@bcp/storage` object (the uploaded
/// or generated contract document) the same way `LeadAttachment` does.
model ClientContract {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @map("client_id") @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  eventId  String? @map("event_id") @db.Uuid

  title    String
  status   ContractStatus @default(draft)
  fileKey  String?        @map("file_key")
  signedAt DateTime?      @map("signed_at")
  signedByName String?    @map("signed_by_name") // the typed full name a client enters as their signature in the portal — this codebase's signing mechanism throughout is typed-name + timestamp, not a captured image, the same lightweight approach OTP-based flows elsewhere use in place of a password

  templateId           String? @map("template_id") @db.Uuid
  publicToken           String  @unique @default(uuid()) @map("public_token")
  currentVersionNumber   Int     @default(1) @map("current_version_number")
  variableValues         Json?   @map("variable_values") // the filled-in values for the template's own variables, at the current version

  witnessRequired  Boolean   @default(false) @map("witness_required")
  witnessName      String?   @map("witness_name")
  witnessEmail     String?   @map("witness_email")
  witnessSignedAt  DateTime? @map("witness_signed_at")
  witnessIpAddress String?   @map("witness_ip_address")

  signerIpAddress  String? @map("signer_ip_address")
  signerUserAgent  String? @map("signer_user_agent")

  signerOtpCode        String?   @map("signer_otp_code")
  signerOtpExpiresAt   DateTime? @map("signer_otp_expires_at")
  signerOtpVerifiedAt  DateTime? @map("signer_otp_verified_at")

  certificateFileKey String? @map("certificate_file_key") // the generated PDF signing certificate — IP, timestamp, OTP verification proof, witness details, all in one document

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  event  Event? @relation(fields: [eventId], references: [id])
  template ContractTemplate? @relation(fields: [templateId], references: [id])
  bookings Booking[]
  versions  ContractVersion[]
  auditLogEntries ContractAuditLogEntry[]

  @@index([clientId])
  @@index([studioId])
  @@map("client_contracts")
}

/// A print order for an album — separate from `Album.status` (which
/// tracks the selection/design pipeline up to "printing") because a
/// single album can have multiple print runs (extra copies, a reprint),
/// each with its own vendor timeline.
/// Expanded in Prompt 32 from the Prompt 11 minimal shape
/// (status/copies/notes) with the print specifications, lab details,
/// and courier tracking the brief names. `printSpecification` is a
/// JSON blob (size, paper stock, binding, cover material) rather than
/// typed columns — the same "studio/lab-specific, not worth a fixed
/// schema" reasoning as `PlanLimits` and branding tokens elsewhere in
/// this codebase; a print spec's shape genuinely varies by lab and
/// product line in a way column additions would chase forever.
model PrintOrder {
  id      String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  albumId String @map("album_id") @db.Uuid

  status     PrintOrderStatus @default(queued)
  copies     Int              @default(1)
  orderedAt  DateTime         @default(now()) @map("ordered_at")
  completedAt DateTime?       @map("completed_at")
  notes      String?

  printSpecification Json?   @map("print_specification") // { size, paperStock, binding, coverMaterial, ... }

  labName        String? @map("lab_name")
  labContactName String? @map("lab_contact_name")
  labContactPhone String? @map("lab_contact_phone")
  labContactEmail String? @map("lab_contact_email")

  courierName     String?   @map("courier_name")
  trackingNumber  String?   @map("tracking_number")
  dispatchedAt    DateTime? @map("dispatched_at")
  deliveredAt     DateTime? @map("delivered_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([albumId])
  @@map("print_orders")
}

/// A delivery of physical or digital output to a client — the
/// "Deliveries" timeline entry. `eventId` (not `clientId` directly)
/// since deliveries are naturally scoped to a shoot; the client-facing
/// timeline joins through the event's client.
model Delivery {
  id      String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  eventId String @map("event_id") @db.Uuid

  method      DeliveryMethod @default(digital_download)
  status      DeliveryStatus @default(pending)
  trackingInfo String?       @map("tracking_info")
  deliveredAt DateTime?      @map("delivered_at")

  createdAt DateTime @default(now()) @map("created_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([eventId])
  @@map("deliveries")
}

/// Post-shoot client feedback — a simple 1-5 rating plus a comment,
/// tied to the event it's about. Feeds the relationship-score heuristic
/// (see packages/clients/src/scoring.ts) alongside payment and
/// communication history.
model ClientFeedback {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @map("client_id") @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  eventId  String? @map("event_id") @db.Uuid

  rating  Int // 1-5
  comment String?

  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  event  Event? @relation(fields: [eventId], references: [id])

  @@index([clientId])
  @@index([studioId])
  @@map("client_feedback")
}

// ═══════════════════════════════════════════════════════════════════════
// SERVICES & PACKAGES (Prompt 15)
// ═══════════════════════════════════════════════════════════════════════

/// A single sellable line item (Traditional Photography, Drone, Album,
/// ...). `internalPrice` is the studio's own cost/rate for this
/// service — never shown to a customer directly; it's only ever
/// aggregated into a Package's internal cost total. See
/// packages/catalog/docs (via docs/services-and-packages.md) for the
/// enforcement rule around this.
model Service {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  name          String
  category      ServiceCategory
  description   String?
  internalPrice Int             @map("internal_price") // paise — studio's own cost/rate, never customer-facing directly
  unit          ServiceUnit     @default(per_event)
  isActive      Boolean         @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  studio         Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  packageServices PackageService[]
  eventServices   EventService[]

  @@index([studioId])
  @@index([studioId, category])
  @@map("services")
}

/// A sellable bundle of services with its own customer-facing price —
/// deliberately *not* required to equal the sum of its services'
/// internal prices (a studio bundles/discounts intentionally).
/// `itemLevelPricingEnabled` is the one flag that gates whether a
/// customer-facing rendering of this package is allowed to show
/// individual service prices at all — off by default. See
/// docs/services-and-packages.md for where this is enforced.
model Package {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid

  name      String
  eventType String  @map("event_type")
  description String?

  customerFacingTotal Int     @map("customer_facing_total") // paise — what the customer is quoted, independent of summed service internal prices
  itemLevelPricingEnabled Boolean @default(false) @map("item_level_pricing_enabled")

  durationLabel      String? @map("duration_label") // "6 hours", "Full day", "2 days" — free text since shoot durations vary too much for a single unit
  teamRequirement     String? @map("team_requirement") // "1 photographer, 1 videographer" — free text for the same reason
  deliverables        String[] @map("deliverables")

  taxRatePercent Float   @default(0) @map("tax_rate_percent")
  taxInclusive   Boolean @default(false) @map("tax_inclusive")

  discountAllowed    Boolean @default(false) @map("discount_allowed")
  maxDiscountPercent Float?  @map("max_discount_percent")

  termsText String? @map("terms_text")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  studio          Studio                       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  packageServices PackageService[]
  addOns          PackageAddOn[]
  paymentSchedule PackagePaymentScheduleItem[]
  quotations      Quotation[]
  bookings        Booking[]

  @@index([studioId])
  @@index([studioId, eventType])
  @@map("packages")
}

/// Join row between a Package and the Services included in it —
/// snapshots the service's internal price *at the time it was added*
/// (`internalPriceSnapshot`) so editing a Service's price later doesn't
/// silently rewrite the internal cost of packages already built from it.
model PackageService {
  id        String @id @default(uuid()) @db.Uuid
  packageId String @map("package_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  quantity              Int @default(1)
  internalPriceSnapshot Int @map("internal_price_snapshot") // paise, per unit, at time of adding

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@index([serviceId])
  @@map("package_services")
}

/// An optional extra a customer can add on top of a package (extra
/// album pages, a same-day edit, additional hours) — has its own
/// customer-facing price; not part of the package's base total.
model PackageAddOn {
  id        String @id @default(uuid()) @db.Uuid
  packageId String @map("package_id") @db.Uuid

  name  String
  price Int    // paise, customer-facing
  description String?

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_add_ons")
}

/// One milestone in a package's payment schedule (e.g. "30% on
/// booking", "40% before the event", "30% on delivery") — `order`
/// determines display/enforcement sequence; percentages across a
/// package's schedule are expected to sum to 100 but that's validated
/// at the application layer (packages/catalog), not a DB constraint.
model PackagePaymentScheduleItem {
  id        String @id @default(uuid()) @db.Uuid
  packageId String @map("package_id") @db.Uuid

  label       String
  percentage  Float
  trigger     PaymentScheduleTrigger @default(on_booking)
  customDays  Int?                   @map("custom_days") // used with custom_days_before_event / custom_days_after_event
  order       Int

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_payment_schedule_items")
}

// ═══════════════════════════════════════════════════════════════════════
// BOOKING MANAGEMENT (Prompt 17)
// ═══════════════════════════════════════════════════════════════════════

/// The "spine" that ties an accepted quotation to everything that
/// follows: the Events it covers (a booking can span several — e.g.
/// engagement + wedding + reception), the team, the payment schedule,
/// and the production pipeline all the way to delivery. Deliberately
/// doesn't duplicate what Event/Gallery/Album/PrintOrder/Delivery
/// already track per-shoot — a Booking owns one or more `Event`s (via
/// `Event.bookingId`) and those in turn own their own galleries/albums/
/// print orders/deliveries, so `BookingStatus` is the studio's
/// explicit, authoritative read of the overall engagement's stage, not
/// a value mechanically derived from child records.
model Booking {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid

  bookingNumber String        @map("booking_number")
  clientId      String        @map("client_id") @db.Uuid
  packageId     String?       @map("package_id") @db.Uuid
  quotationId   String?       @unique @map("quotation_id") @db.Uuid
  contractId    String?       @map("contract_id") @db.Uuid

  status BookingStatus @default(draft)

  deliverables String[] @default([])
  notes        String?

  internalCost     Int @default(0) @map("internal_cost") // paise, studio-only
  sellingPrice     Int @default(0) @map("selling_price") // paise, customer-facing
  estimatedProfit  Int @default(0) @map("estimated_profit") // paise, sellingPrice - internalCost, resolved on write

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio    Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client    Client          @relation(fields: [clientId], references: [id])
  package   Package?        @relation(fields: [packageId], references: [id])
  quotation Quotation?      @relation(fields: [quotationId], references: [id])
  contract  ClientContract? @relation(fields: [contractId], references: [id])

  events          Event[]
  lineItems       BookingLineItem[]
  teamAssignments BookingTeamAssignment[]
  paymentSchedule BookingPaymentScheduleItem[]
  workflowInstances WorkflowInstance[]
  tasks             Task[]
  freelancerPayments FreelancerPayment[]
  expenses Expense[]

  @@unique([studioId, bookingNumber])
  @@index([studioId])
  @@index([studioId, status])
  @@map("bookings")
}

/// Services snapshotted onto the booking — same "copy, don't
/// reference" rationale as `QuotationLineItem`: a booking already in
/// progress shouldn't change if the catalog or the source quotation is
/// edited afterward. Usually copied straight from the accepted
/// quotation's line items at conversion time.
model BookingLineItem {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid

  name          String
  quantity      Int @default(1)
  unitPrice     Int @map("unit_price") // paise, customer-facing basis
  internalPrice Int? @map("internal_price") // paise, services only

  order Int @default(0)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_line_items")
}

/// Team members assigned to the booking as a whole — distinct from
/// `EventAssignment`, which is per-shoot. A booking's videographer
/// might work every event in it; assigning them once here is simpler
/// than re-assigning per event, though per-event overrides remain
/// possible via `EventAssignment` directly.
model BookingTeamAssignment {
  id           String  @id @default(uuid()) @db.Uuid
  bookingId    String  @map("booking_id") @db.Uuid
  studioUserId String  @map("studio_user_id") @db.Uuid
  role         String?

  createdAt DateTime @default(now()) @map("created_at")

  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)

  @@unique([bookingId, studioUserId])
  @@index([studioUserId])
  @@map("booking_team_assignments")
}

/// The booking's planned payment milestones — distinct from `Invoice`/
/// `ClientPayment` (which track money actually invoiced and received):
/// this is the plan (often copied from the source quotation's payment
/// schedule), `status` updated as each milestone is actually settled,
/// giving a single place to see "what's due next" without cross-
/// referencing every invoice.
model BookingPaymentScheduleItem {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid

  label      String
  percentage Float
  amount     Int    // paise
  dueDate    DateTime? @map("due_date")
  status     BookingPaymentMilestoneStatus @default(pending)
  order      Int    @default(0)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_payment_schedule_items")
}

// ═══════════════════════════════════════════════════════════════════════
// EVENT & CALENDAR MANAGEMENT (Prompt 18)
// ═══════════════════════════════════════════════════════════════════════

/// Expanded in Prompt 21 from the Prompt 18 minimal shape
/// (name/category/quantity/notes) into a full asset record. `category`
/// stays free text — same "seed-data suggestions, not a DB enum"
/// convention as `Event.eventType`/`@bcp/catalog`'s services — see
/// `@bcp/equipment`'s `EQUIPMENT_CATEGORIES` for the 15 named in the
/// brief. `currentStatus` is the one field actually enforced (double-
/// booking prevention reads it alongside `EquipmentCheckoutRecord`),
/// everything else here is descriptive asset-register detail.
model Equipment {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  name        String
  category    String?
  quantity    Int     @default(1) // how many units the studio owns — a conflict only fires once concurrent bookings exceed this
  notes       String?
  isActive    Boolean @default(true) @map("is_active")

  serialNumber String? @map("serial_number")
  purchaseDate DateTime? @map("purchase_date")
  purchasePrice Int?     @map("purchase_price") // paise
  replacementCost Int?   @map("replacement_cost") // paise — what it'd cost to replace today, which can differ from purchase price

  warrantyExpiresAt   DateTime? @map("warranty_expires_at")
  insurancePolicyNumber String? @map("insurance_policy_number")
  insuranceExpiresAt  DateTime? @map("insurance_expires_at")

  condition      EquipmentCondition @default(good)
  currentStatus  EquipmentStatus    @default(available) @map("current_status")

  qrCodeToken String @unique @default(uuid()) @map("qr_code_token") // opaque identifier encoded into the printable QR code, resolved publicly by apps/studio-web's quick check-in/checkout scan flow

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  events EventEquipment[]
  teamAssignments TeamEquipmentAssignment[]
  maintenanceRecords EquipmentMaintenanceRecord[]
  repairRecords      EquipmentRepairRecord[]
  rentalRecords      EquipmentRentalRecord[]
  damageReports      EquipmentDamageReport[]
  checkoutRecords    EquipmentCheckoutRecord[]

  @@index([studioId])
  @@map("equipment")
}

/// Equipment assigned to a specific event — the join `@bcp/events`'
/// equipment-conflict check reads to detect two events booking more
/// units of the same equipment, at overlapping times, than the studio
/// owns.
model EventEquipment {
  id          String @id @default(uuid()) @db.Uuid
  eventId     String @map("event_id") @db.Uuid
  equipmentId String @map("equipment_id") @db.Uuid
  quantity    Int    @default(1)

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([eventId, equipmentId])
  @@index([equipmentId])
  @@map("event_equipment")
}

/// Which catalog services this specific event is delivering — usually a
/// subset of the parent Booking's line items, scoped down to what
/// actually happens at this particular shoot (e.g. a booking might
/// include "Drone" only for the wedding-day event, not the engagement
/// shoot).
model EventService {
  id        String @id @default(uuid()) @db.Uuid
  eventId   String @map("event_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([eventId, serviceId])
  @@index([serviceId])
  @@map("event_services")
}

/// One shot on the event's shot list — deliberately just a description
/// and a completed flag, not a structured shot-type taxonomy; studios'
/// shot lists vary too much in style (some are a phrase per line, others
/// reference specific poses) to force into fixed fields.
model EventShotListItem {
  id      String  @id @default(uuid()) @db.Uuid
  eventId String  @map("event_id") @db.Uuid

  description String
  completed   Boolean @default(false)
  order       Int     @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_shot_list_items")
}

/// One entry in the event's *intra-day* schedule ("10:00 AM hair &
/// makeup", "12:30 PM ceremony") — distinct from the studio-wide
/// Calendar/Timeline/Agenda *views* of Prompt 18, which are how events
/// themselves are browsed, not a property of any single event.
model EventScheduleItem {
  id      String   @id @default(uuid()) @db.Uuid
  eventId String   @map("event_id") @db.Uuid

  time  DateTime
  label String
  order Int      @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_schedule_items")
}

// ═══════════════════════════════════════════════════════════════════════
// TASK & WORKFLOW ENGINE (Prompt 19)
// ═══════════════════════════════════════════════════════════════════════

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  pending
  in_progress
  blocked
  completed
  cancelled
}

enum TaskApprovalStatus {
  not_required
  pending
  approved
  rejected
}

enum WorkflowInstanceStatus {
  active
  completed
  cancelled
}

enum RecurrenceFrequency {
  daily
  weekly
  monthly
}

/// A reusable, studio-defined workflow blueprint — a named, ordered set
/// of `TaskTemplate`s. `eventType` (free text, matching `Event.eventType`'s
/// convention) is how "workflow customization by event type" works: a
/// studio can define one `WorkflowTemplate` per event type (a Wedding
/// workflow with 17 stages, a simpler Birthday workflow with 6) plus one
/// `isDefault` template with `eventType = null` as the fallback for any
/// type without its own. See `@bcp/workflow`'s `DEFAULT_WORKFLOW_STAGES`
/// for the 17-stage default named in the brief, seeded the same
/// "one-click starting point, not a fixture" way `@bcp/catalog`'s
/// `DEFAULT_SERVICES` is.
model WorkflowTemplate {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid

  name        String
  eventType   String? @map("event_type") // null = studio-wide default
  description String?
  isDefault   Boolean @default(false) @map("is_default")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  studio    Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  tasks     TaskTemplate[]
  instances WorkflowInstance[]

  @@index([studioId])
  @@index([studioId, eventType])
  @@map("workflow_templates")
}

/// One task blueprint within a `WorkflowTemplate` — instantiated into a
/// real `Task` every time the workflow is applied to a booking/event.
/// `dependsOnTaskTemplateIds`/`stageKey` are plain arrays/text rather
/// than a join table or DB enum — dependencies are read as "the full
/// prerequisite list for this one task," not queried from the reverse
/// direction at any scale that would need a relational join, and stage
/// names need the same studio-customizable freedom `Event.eventType`
/// already has.
model TaskTemplate {
  id                 String @id @default(uuid()) @db.Uuid
  studioId           String @map("studio_id") @db.Uuid
  workflowTemplateId String @map("workflow_template_id") @db.Uuid

  stageKey    String  @map("stage_key")
  name        String
  description String?
  order       Int     @default(0)

  defaultAssigneeRole   String?  @map("default_assignee_role") // e.g. "photographer" — resolved against StudioRole at instantiation time, not a hard user reference
  defaultDueOffsetDays  Int?     @map("default_due_offset_days") // relative to the event's scheduledAt; negative = before the shoot
  priority              TaskPriority @default(medium)
  isApprovalStep         Boolean  @default(false) @map("is_approval_step")
  slaHours               Int?     @map("sla_hours")
  isRecurring             Boolean  @default(false) @map("is_recurring")
  recurrenceFrequency     RecurrenceFrequency? @map("recurrence_frequency")
  recurrenceInterval      Int?     @map("recurrence_interval") // every N frequency units

  dependsOnTaskTemplateIds String[] @default([]) @map("depends_on_task_template_ids")
  checklistItems           String[] @default([]) @map("checklist_items") // seeded onto each instantiated Task's own TaskChecklistItem rows

  studio           Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  workflowTemplate WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  tasks            Task[]

  @@index([studioId])
  @@index([workflowTemplateId])
  @@map("task_templates")
}

/// One application of a `WorkflowTemplate` to a specific booking or
/// event — the container `Task`s created from that template's
/// `TaskTemplate`s belong to. Exactly one of `bookingId`/`eventId` is
/// expected to be set in practice (a booking-level workflow like
/// "Advance payment" vs. a shoot-specific one like "Backup"), both kept
/// optional rather than a discriminated union since a workflow could
/// reasonably track either.
model WorkflowInstance {
  id                 String @id @default(uuid()) @db.Uuid
  studioId           String @map("studio_id") @db.Uuid
  workflowTemplateId String @map("workflow_template_id") @db.Uuid
  bookingId          String? @map("booking_id") @db.Uuid
  eventId            String? @map("event_id") @db.Uuid

  status      WorkflowInstanceStatus @default(active)
  startedAt   DateTime               @default(now()) @map("started_at")
  completedAt DateTime?              @map("completed_at")

  studio           Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  workflowTemplate WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id])
  booking          Booking?         @relation(fields: [bookingId], references: [id])
  event            Event?           @relation(fields: [eventId], references: [id])
  tasks            Task[]

  @@index([studioId])
  @@index([bookingId])
  @@index([eventId])
  @@map("workflow_instances")
}

/// A real, actionable task — either instantiated from a `TaskTemplate`
/// (`taskTemplateId` set) or created ad hoc (`taskTemplateId` null,
/// `workflowInstanceId` also nullable for a fully standalone task not
/// tied to any workflow at all, e.g. a one-off reminder). SLA and
/// escalation are resolved fields here (`slaDeadline`, `escalatedAt`)
/// rather than recomputed on every read, since "is this overdue" needs
/// to be queryable/sortable across many tasks at once — see
/// `@bcp/workflow`'s `resolveSlaStatus()` for the pure logic and
/// `apps/api`'s escalation sweep for what actually sets these fields.
model Task {
  id                 String  @id @default(uuid()) @db.Uuid
  studioId           String  @map("studio_id") @db.Uuid
  workflowInstanceId String? @map("workflow_instance_id") @db.Uuid
  taskTemplateId     String? @map("task_template_id") @db.Uuid
  bookingId          String? @map("booking_id") @db.Uuid
  eventId            String? @map("event_id") @db.Uuid

  stageKey    String? @map("stage_key")
  title       String
  description String?
  order       Int     @default(0)

  assigneeId String? @map("assignee_id") @db.Uuid
  dueDate    DateTime? @map("due_date")
  priority   TaskPriority @default(medium)
  status     TaskStatus   @default(pending)

  isApprovalStep   Boolean             @default(false) @map("is_approval_step")
  approvalStatus   TaskApprovalStatus  @default(not_required) @map("approval_status")
  approvedByUserId String?             @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?           @map("approved_at")

  slaHours     Int?      @map("sla_hours")
  slaDeadline  DateTime? @map("sla_deadline")
  escalatedAt  DateTime? @map("escalated_at")
  escalatedToUserId String? @map("escalated_to_user_id") @db.Uuid

  isRecurring         Boolean              @default(false) @map("is_recurring")
  recurrenceFrequency RecurrenceFrequency? @map("recurrence_frequency")
  recurrenceInterval  Int?                 @map("recurrence_interval")
  nextOccurrenceAt    DateTime?            @map("next_occurrence_at")

  dependsOnTaskIds String[] @default([]) @map("depends_on_task_ids")

  completedAt DateTime? @map("completed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  studio           Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  workflowInstance WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  taskTemplate     TaskTemplate?     @relation(fields: [taskTemplateId], references: [id])
  booking          Booking?          @relation(fields: [bookingId], references: [id])
  event            Event?            @relation(fields: [eventId], references: [id])
  assignee         StudioUser?       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  escalatedTo      StudioUser?       @relation("TaskEscalatedTo", fields: [escalatedToUserId], references: [id])

  checklistItems TaskChecklistItem[]
  comments       TaskComment[]
  attachments    TaskAttachment[]

  @@index([studioId])
  @@index([studioId, status])
  @@index([studioId, dueDate])
  @@index([workflowInstanceId])
  @@index([assigneeId])
  @@index([bookingId])
  @@index([eventId])
  @@map("tasks")
}

model TaskChecklistItem {
  id     String @id @default(uuid()) @db.Uuid
  taskId String @map("task_id") @db.Uuid

  description String
  completed   Boolean @default(false)
  order       Int     @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklist_items")
}

model TaskComment {
  id       String @id @default(uuid()) @db.Uuid
  taskId   String @map("task_id") @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  body     String
  authorId String? @map("author_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([studioId])
  @@map("task_comments")
}

/// Points at a `@bcp/storage` object, same `fileKey` convention as
/// `LeadAttachment`/`ClientContract`.
model TaskAttachment {
  id       String @id @default(uuid()) @db.Uuid
  taskId   String @map("task_id") @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  fileName   String @map("file_name")
  fileKey    String @map("file_key")
  uploadedBy String? @map("uploaded_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([studioId])
  @@map("task_attachments")
}

// ═══════════════════════════════════════════════════════════════════════
// TEAM, ATTENDANCE & FREELANCERS (Prompt 20)
// ═══════════════════════════════════════════════════════════════════════

enum EmploymentType {
  employee
  freelancer
}

enum AvailabilityStatus {
  available
  busy
  on_leave
  unavailable
}

enum AttendanceStatus {
  present
  absent
  half_day
  leave
  holiday
}

enum LeaveType {
  sick
  casual
  paid
  unpaid
  other
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum TeamDocumentType {
  contract
  id_proof
  certification
  other
}

enum FreelancerPaymentStatus {
  pending
  paid
  cancelled
}

enum EquipmentCondition {
  excellent
  good
  fair
  poor
  damaged
}

enum EquipmentStatus {
  available
  checked_out
  in_maintenance
  in_repair
  retired
}

enum MaintenanceType {
  routine
  cleaning
  calibration
  firmware_update
  other
}

enum RepairStatus {
  reported
  in_repair
  resolved
  unrepairable
}

enum RentalDirection {
  rented_out
  rented_in
}

enum DamageSeverity {
  minor
  moderate
  severe
  total_loss
}

/// The heavier, more sensitive half of a team member's HR record —
/// split from `StudioUser` itself (which stays lean since it's read on
/// every authenticated request) the same way `TeamMemberProfile` being
/// a separate one-to-one table means a plain "who's on the team" list
/// never has to pull salary or bank details along with it. Employee-
/// only fields (`salaryAmount`) and freelancer-only fields
/// (`freelancerRateAmount`/`freelancerRateUnit`) both live here rather
/// than in two separate tables, since which half applies is already
/// determined by `StudioUser.employmentType` — no need to enforce that
/// split at the schema level too.
model TeamMemberProfile {
  id           String @id @default(uuid()) @db.Uuid
  studioUserId String @unique @map("studio_user_id") @db.Uuid
  studioId     String @map("studio_id") @db.Uuid

  salaryAmount   Int?    @map("salary_amount") // paise/month, employees
  freelancerRateAmount Int?    @map("freelancer_rate_amount") // paise, freelancers
  freelancerRateUnit   String? @map("freelancer_rate_unit") // "per_day" | "per_event" | "per_hour"
  paymentTerms         String? @map("payment_terms")

  bankAccountName   String? @map("bank_account_name")
  bankAccountNumber String? @map("bank_account_number")
  bankIfscCode      String? @map("bank_ifsc_code")
  bankName          String? @map("bank_name")

  emergencyContactName         String? @map("emergency_contact_name")
  emergencyContactPhone        String? @map("emergency_contact_phone")
  emergencyContactRelationship String? @map("emergency_contact_relationship")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)
  studio     Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("team_member_profiles")
}

/// Points at a `@bcp/storage` object, same `fileKey` convention used
/// throughout (`LeadAttachment`, `ClientContract`, `TaskAttachment`).
/// `expiresAt` exists specifically for certifications (a drone pilot
/// license, an equipment certification) that lapse — nothing
/// automated acts on it yet, but it's there for a studio to sort/filter
/// by "expiring soon" without parsing free text.
model TeamDocument {
  id           String @id @default(uuid()) @db.Uuid
  studioUserId String @map("studio_user_id") @db.Uuid
  studioId     String @map("studio_id") @db.Uuid

  name         String
  documentType TeamDocumentType @default(other) @map("document_type")
  fileKey      String @map("file_key")
  expiresAt    DateTime? @map("expires_at")
  uploadedBy   String?   @map("uploaded_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)
  studio     Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioUserId])
  @@index([studioId])
  @@map("team_documents")
}

/// Equipment checked out to a team member — custody tracking, distinct
/// from `EventEquipment` (which books a piece of equipment for a
/// specific shoot's duration). A camera can be assigned to a
/// photographer long-term while still being booked per-event; the two
/// models track different questions ("who's responsible for this
/// item generally" vs. "is this item free at this specific time").
model TeamEquipmentAssignment {
  id           String @id @default(uuid()) @db.Uuid
  studioUserId String @map("studio_user_id") @db.Uuid
  equipmentId  String @map("equipment_id") @db.Uuid
  studioId     String @map("studio_id") @db.Uuid

  assignedAt DateTime  @default(now()) @map("assigned_at")
  returnedAt DateTime? @map("returned_at")
  notes      String?

  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)
  equipment  Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  studio     Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioUserId])
  @@index([equipmentId])
  @@index([studioId])
  @@map("team_equipment_assignments")
}

model AttendanceRecord {
  id           String @id @default(uuid()) @db.Uuid
  studioUserId String @map("studio_user_id") @db.Uuid
  studioId     String @map("studio_id") @db.Uuid

  date       DateTime // stored at midnight UTC for the calendar day — one row per person per day
  status     AttendanceStatus @default(present)
  checkInAt  DateTime? @map("check_in_at")
  checkOutAt DateTime? @map("check_out_at")
  notes      String?

  createdAt DateTime @default(now()) @map("created_at")

  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)
  studio     Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioUserId, date])
  @@index([studioId])
  @@index([studioId, date])
  @@map("attendance_records")
}

model LeaveRequest {
  id           String @id @default(uuid()) @db.Uuid
  studioUserId String @map("studio_user_id") @db.Uuid
  studioId     String @map("studio_id") @db.Uuid

  leaveType LeaveType   @default(casual) @map("leave_type")
  startDate DateTime    @map("start_date")
  endDate   DateTime    @map("end_date")
  status    LeaveStatus @default(pending)
  reason    String?

  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")

  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)
  studio     Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioUserId])
  @@index([studioId])
  @@index([studioId, status])
  @@map("leave_requests")
}

/// A qualitative performance review entry — deliberately just a rating
/// and free-text note tied to a period label ("Q3 2026"), not a
/// structured review-template system. Quantitative performance
/// (task completion rate, attendance rate) is computed on read from
/// `Task`/`AttendanceRecord` directly by `@bcp/team` rather than
/// duplicated into a stored metric here — this model is only for the
/// qualitative judgment a manager adds on top of those numbers.
model PerformanceNote {
  id           String @id @default(uuid()) @db.Uuid
  studioUserId String @map("studio_user_id") @db.Uuid
  studioId     String @map("studio_id") @db.Uuid

  periodLabel String  @map("period_label")
  ratingScore Int?    @map("rating_score") // 1-5
  note        String?

  reviewedByUserId String?  @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime @default(now()) @map("reviewed_at")

  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)
  studio     Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioUserId])
  @@index([studioId])
  @@map("performance_notes")
}

/// A payment made *to* a freelancer for their work — the mirror image
/// of `ClientPayment` (money coming *from* a client). Kept as its own
/// model rather than overloading `Invoice`/`ClientPayment`, which are
/// specifically about money owed by clients, not studio outgoings.
model FreelancerPayment {
  id           String @id @default(uuid()) @db.Uuid
  studioUserId String @map("studio_user_id") @db.Uuid
  studioId     String @map("studio_id") @db.Uuid
  eventId      String? @map("event_id") @db.Uuid
  bookingId    String? @map("booking_id") @db.Uuid

  amount Int // paise
  status FreelancerPaymentStatus @default(pending)
  dueDate DateTime? @map("due_date")
  paidAt  DateTime? @map("paid_at")
  notes   String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)
  studio     Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  event      Event?     @relation(fields: [eventId], references: [id])
  booking    Booking?   @relation(fields: [bookingId], references: [id])

  @@index([studioUserId])
  @@index([studioId])
  @@index([studioId, status])
  @@map("freelancer_payments")
}

// ═══════════════════════════════════════════════════════════════════════
// EQUIPMENT MANAGEMENT (Prompt 21)
// ═══════════════════════════════════════════════════════════════════════

model EquipmentMaintenanceRecord {
  id          String @id @default(uuid()) @db.Uuid
  equipmentId String @map("equipment_id") @db.Uuid
  studioId    String @map("studio_id") @db.Uuid

  maintenanceType MaintenanceType @default(routine) @map("maintenance_type")
  performedAt     DateTime        @map("performed_at")
  description     String?
  cost            Int?            // paise
  performedBy     String?         @map("performed_by") // free text — often an external vendor, not necessarily a StudioUser
  nextDueAt       DateTime?       @map("next_due_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([studioId])
  @@map("equipment_maintenance_records")
}

model EquipmentRepairRecord {
  id          String @id @default(uuid()) @db.Uuid
  equipmentId String @map("equipment_id") @db.Uuid
  studioId    String @map("studio_id") @db.Uuid

  status          RepairStatus @default(reported)
  reportedAt      DateTime     @default(now()) @map("reported_at")
  issueDescription String      @map("issue_description")
  vendor          String?
  cost            Int?         // paise
  resolvedAt      DateTime?    @map("resolved_at")

  createdBy String? @map("created_by") @db.Uuid

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([studioId])
  @@map("equipment_repair_records")
}

/// Deliberately bidirectional (`direction`) rather than two separate
/// models — a studio renting a specialty lens *in* for one job and
/// renting a spare body *out* to another studio are the same shape of
/// record (who, when, how much), just opposite directions of the same
/// transaction.
model EquipmentRentalRecord {
  id          String @id @default(uuid()) @db.Uuid
  equipmentId String @map("equipment_id") @db.Uuid
  studioId    String @map("studio_id") @db.Uuid

  direction       RentalDirection
  counterpartyName String         @map("counterparty_name")
  startDate       DateTime        @map("start_date")
  endDate         DateTime        @map("end_date")
  cost            Int?            // paise
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([studioId])
  @@map("equipment_rental_records")
}

model EquipmentDamageReport {
  id          String @id @default(uuid()) @db.Uuid
  equipmentId String @map("equipment_id") @db.Uuid
  studioId    String @map("studio_id") @db.Uuid

  severity    DamageSeverity @default(minor)
  description String
  reportedBy  String?        @map("reported_by") @db.Uuid
  reportedAt  DateTime       @default(now()) @map("reported_at")
  photoKeys   String[]       @default([]) @map("photo_keys")
  repairCost  Int?           @map("repair_cost") // paise
  resolvedAt  DateTime?      @map("resolved_at")

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([studioId])
  @@map("equipment_damage_reports")
}

/// The short-term "who has this right now" transactional log — QR-code
/// driven check-in/checkout — distinct from `TeamEquipmentAssignment`
/// (Prompt 20's long-term custody tracking: a camera permanently
/// assigned to a photographer) and from `EventEquipment` (a per-shoot
/// booking). A studio can use any subset of these three depending on
/// how formally it wants to track its gear; none of them replace the
/// others. `checkedInAt` null means it's still out — that's the field
/// double-booking prevention checks alongside `Equipment.quantity`.
model EquipmentCheckoutRecord {
  id          String @id @default(uuid()) @db.Uuid
  equipmentId String @map("equipment_id") @db.Uuid
  studioId    String @map("studio_id") @db.Uuid
  eventId     String? @map("event_id") @db.Uuid

  checkedOutByUserId String    @map("checked_out_by_user_id") @db.Uuid
  checkedOutAt       DateTime  @default(now()) @map("checked_out_at")
  expectedReturnAt   DateTime? @map("expected_return_at")
  checkedInAt        DateTime? @map("checked_in_at")

  conditionAtCheckout EquipmentCondition? @map("condition_at_checkout")
  conditionAtCheckin  EquipmentCondition? @map("condition_at_checkin")
  notes               String?

  equipment Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  studio    Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  event     Event?     @relation(fields: [eventId], references: [id])
  checkedOutBy StudioUser @relation(fields: [checkedOutByUserId], references: [id])

  @@index([equipmentId])
  @@index([studioId])
  @@index([equipmentId, checkedInAt])
  @@map("equipment_checkout_records")
}

// ═══════════════════════════════════════════════════════════════════════
// VENDORS, EXPENSES & PROFIT (Prompt 22)
// ═══════════════════════════════════════════════════════════════════════

/// `category` is free text with 11 suggested values (`@bcp/finance`'s
/// `VENDOR_CATEGORIES`) — same "seed-data suggestions, not a DB enum"
/// convention as `Equipment.category`/`Event.eventType`, since studios
/// work with vendor types this list can't fully anticipate.
model Vendor {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid

  name        String
  category    String?
  contactPersonName String? @map("contact_person_name")
  contactPhone      String? @map("contact_phone")
  contactEmail      String? @map("contact_email")
  address           String?
  gstin             String?
  paymentTerms      String? @map("payment_terms")
  notes             String?
  isActive          Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio         Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  purchaseOrders PurchaseOrder[]
  bills          VendorBill[]

  @@index([studioId])
  @@map("vendors")
}

/// A named allocation bucket for expenses — deliberately a separate
/// dimension from `StudioBranch` (a cost centre isn't necessarily a
/// physical location; "Marketing Campaign Q3" or "Studio A Equipment"
/// are cost centres a studio might track across branches, or within
/// one).
model CostCentre {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  studio   Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([studioId])
  @@map("cost_centres")
}

/// Deliberately minimal — a single amount and description rather than
/// a full line-item breakdown like `Quotation`/`Booking` — most of a
/// photography studio's purchase orders to a vendor (album covers,
/// frames, a courier run) are single-line in practice; multi-line POs
/// are a reasonable future addition if a studio's vendor relationships
/// grow complex enough to need it.
model PurchaseOrder {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid
  vendorId String  @map("vendor_id") @db.Uuid

  poNumber    String              @map("po_number")
  status      PurchaseOrderStatus @default(draft)
  description String
  amount      Int // paise
  expectedDeliveryDate DateTime?  @map("expected_delivery_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio   Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  vendor   Vendor     @relation(fields: [vendorId], references: [id])
  expenses Expense[]
  bills    VendorBill[]

  @@unique([studioId, poNumber])
  @@index([studioId])
  @@map("purchase_orders")
}

/// A bill *from* a vendor — the payable-side mirror of `Invoice` (which
/// is receivable, money owed *by* a client). `gstAmount`/`tdsAmount`
/// follow the same convention `Quotation`/`Expense` use elsewhere in
/// this schema.
model VendorBill {
  id              String  @id @default(uuid()) @db.Uuid
  studioId        String  @map("studio_id") @db.Uuid
  vendorId        String  @map("vendor_id") @db.Uuid
  purchaseOrderId String? @map("purchase_order_id") @db.Uuid

  billNumber String   @map("bill_number")
  billDate   DateTime @map("bill_date")
  dueDate    DateTime? @map("due_date")

  amount      Int // paise, before tax
  gstAmount   Int @default(0) @map("gst_amount")
  tdsAmount   Int @default(0) @map("tds_amount")
  totalAmount Int @map("total_amount") // amount + gstAmount - tdsAmount
  amountPaid  Int @default(0) @map("amount_paid")

  status VendorBillStatus @default(unpaid)
  notes  String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio        Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  expenses      Expense[]

  @@index([studioId])
  @@index([studioId, status])
  @@index([vendorId])
  @@map("vendor_bills")
}

// ═══════════════════════════════════════════════════════════════════════
// INVOICE, RECEIPT & PAYMENTS (Prompt 23)
// ═══════════════════════════════════════════════════════════════════════

/// One receipt per payment, always — see `ClientPayment`'s doc comment.
/// Numbered the same branch/financial-year-aware way as `Invoice`, its
/// own independent sequence (a studio's receipt numbers and invoice
/// numbers are two different traceable sequences, not one shared
/// counter).
model Receipt {
  id        String @id @default(uuid()) @db.Uuid
  studioId  String @map("studio_id") @db.Uuid
  paymentId String @unique @map("payment_id") @db.Uuid

  receiptNumber String   @map("receipt_number")
  financialYear String   @map("financial_year")
  issuedAt      DateTime @default(now()) @map("issued_at")

  studio  Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  payment ClientPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([studioId, receiptNumber])
  @@index([studioId])
  @@map("receipts")
}

/// Reduces what's owed on an already-issued invoice — a post-invoice
/// discount, correction, or goodwill adjustment — without editing the
/// original invoice (which stays an immutable record of what was
/// originally billed). `status` tracks whether it's just been issued,
/// been applied against the invoice's balance, or cancelled before
/// application.
model CreditNote {
  id        String @id @default(uuid()) @db.Uuid
  studioId  String @map("studio_id") @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid

  creditNoteNumber String           @map("credit_note_number")
  financialYear    String           @map("financial_year")
  amount           Int // paise
  reason           String?
  status           CreditNoteStatus @default(issued)

  issuedAt DateTime @default(now()) @map("issued_at")
  createdBy String? @map("created_by") @db.Uuid

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([studioId, creditNoteNumber])
  @@index([studioId])
  @@index([invoiceId])
  @@map("credit_notes")
}

/// Money actually returned to a client — distinct from a `CreditNote`
/// (which reduces what's owed, but doesn't necessarily mean cash moved)
/// the same way a `ClientPayment` is distinct from an `Invoice`: one is
/// the obligation, the other is the real movement of money.
model RefundReceipt {
  id        String  @id @default(uuid()) @db.Uuid
  studioId  String  @map("studio_id") @db.Uuid
  paymentId String? @map("payment_id") @db.Uuid

  refundReceiptNumber String   @map("refund_receipt_number")
  financialYear       String   @map("financial_year")
  amount              Int // paise
  reason              String?
  method              PaymentMethod @default(other)
  refundedAt          DateTime @default(now()) @map("refunded_at")

  createdBy String? @map("created_by") @db.Uuid

  studio  Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  payment ClientPayment? @relation(fields: [paymentId], references: [id])

  @@unique([studioId, refundReceiptNumber])
  @@index([studioId])
  @@map("refund_receipts")
}

// ═══════════════════════════════════════════════════════════════════════
// WHATSAPP INTEGRATION (Prompt 24)
// ═══════════════════════════════════════════════════════════════════════

enum WhatsAppTemplateCategory {
  marketing
  utility
  authentication
}

enum WhatsAppTemplateStatus {
  pending
  approved
  rejected
}

enum WhatsAppMessageType {
  text
  template
  image
  document
}

enum WhatsAppMessageStatus {
  queued
  sent
  delivered
  read
  failed
}

enum WhatsAppOptInStatus {
  opted_in
  opted_out
  unknown
}

/// One WhatsApp Cloud API configuration per studio. `accessToken`/
/// `webhookVerifyToken` are stored the same way every other external-
/// integration credential in this schema is (plain field — this
/// codebase has no secret-encryption infrastructure to plug into, the
/// same honest limitation as OAuth tokens elsewhere); a real deployment
/// would put these behind a secrets manager, not a schema change.
model WhatsAppConfig {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @unique @map("studio_id") @db.Uuid

  metaBusinessId     String? @map("meta_business_id")
  wabaId             String? @map("waba_id") // WhatsApp Business Account ID
  phoneNumberId      String? @map("phone_number_id")
  accessToken        String? @map("access_token")
  webhookVerifyToken String? @map("webhook_verify_token")
  defaultSenderLabel String? @map("default_sender_label") // display name shown as the sending identity in-app, distinct from Meta's own display name approval process
  isActive           Boolean @default(false) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio    Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  templates WhatsAppTemplate[]

  @@map("whatsapp_configs")
}

/// A template approved in Meta Business Manager, mirrored here so the
/// studio can pick from and preview them in-app. `bodyText` keeps
/// `{{1}}`, `{{2}}`... placeholders exactly as Meta's template syntax
/// uses them — `@bcp/whatsapp`'s `previewTemplate()` substitutes real
/// values into those placeholders for the preview feature, the same
/// placeholder convention Meta itself uses so there's no translation
/// layer to keep in sync.
model WhatsAppTemplate {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  configId String @map("config_id") @db.Uuid

  name           String
  category       WhatsAppTemplateCategory @default(utility)
  language       String                   @default("en")
  bodyText       String                   @map("body_text")
  variableCount  Int                      @default(0) @map("variable_count")
  status         WhatsAppTemplateStatus   @default(pending)
  metaTemplateId String?                  @map("meta_template_id")

  createdAt DateTime @default(now()) @map("created_at")

  studio   Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  config   WhatsAppConfig   @relation(fields: [configId], references: [id], onDelete: Cascade)
  messages WhatsAppMessage[]

  @@unique([studioId, name, language])
  @@index([studioId])
  @@map("whatsapp_templates")
}

/// The full outbound message log — every WhatsApp send in the system
/// (quotation, invoice, receipt, gallery, reminders, ...) creates one
/// row here, whether sent as free text or via a template. `contextType`/
/// `contextId` is a lightweight polymorphic link (same convention
/// `ActivityLog.resourceType`/`resourceId` already uses) rather than a
/// dozen nullable foreign keys, since a WhatsApp message can reference
/// almost any domain object. Status fields are only ever advanced
/// forward by the webhook handler (`apps/api`'s
/// `whatsapp-webhook.service.ts`) — never invented client-side, since
/// delivered/read receipts only mean something coming from Meta itself.
model WhatsAppMessage {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid
  templateId String? @map("template_id") @db.Uuid

  toPhone     String              @map("to_phone")
  messageType WhatsAppMessageType @map("message_type")
  body        String?
  mediaUrl    String?             @map("media_url")
  variables   Json?               // template variable values actually sent, for audit/preview parity

  contextType String? @map("context_type") // "Quotation" | "Invoice" | "Receipt" | "Gallery" | "Event" | ...
  contextId   String? @map("context_id") @db.Uuid

  status           WhatsAppMessageStatus @default(queued)
  failureReason    String?               @map("failure_reason")
  providerMessageId String?              @map("provider_message_id") // Meta's wamid
  retryCount       Int                   @default(0) @map("retry_count")

  queuedAt    DateTime  @default(now()) @map("queued_at")
  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  failedAt    DateTime? @map("failed_at")

  sentBy String? @map("sent_by") @db.Uuid

  studio   Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  template WhatsAppTemplate? @relation(fields: [templateId], references: [id])

  @@index([studioId])
  @@index([studioId, status])
  @@index([studioId, toPhone])
  @@index([providerMessageId])
  @@map("whatsapp_messages")
}

/// Per-phone-number consent, independent of whether that number belongs
/// to a `Client`, a `Lead`, or neither yet — consent is a property of
/// the phone number a message would go to, not of whichever domain
/// record happens to reference it. `unknown` (not yet asked) is
/// deliberately distinct from `opted_out`; only an explicit opt-out
/// blocks sending.
model WhatsAppOptStatus {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  phone  String
  status WhatsAppOptInStatus @default(unknown)

  updatedAt DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, phone])
  @@index([studioId])
  @@map("whatsapp_opt_statuses")
}

// ═══════════════════════════════════════════════════════════════════════
// EMAIL & NOTIFICATIONS (Prompt 25)
// ═══════════════════════════════════════════════════════════════════════

enum EmailProvider {
  platform_smtp
  studio_smtp
  ses
  resend
}

enum EmailMessageStatus {
  queued
  sent
  delivered
  bounced
  failed
}

/// One email configuration per studio — which provider it uses and
/// that provider's credentials, all optional so a studio can start on
/// `platform_smtp` (the platform's own shared sender, needing no
/// per-studio setup at all) and move to its own SMTP/SES/Resend later
/// without a schema change. Only the fields relevant to the selected
/// `provider` are expected to be populated; the others sit unused
/// rather than needing four separate config tables.
model EmailConfig {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @unique @map("studio_id") @db.Uuid

  provider EmailProvider @default(platform_smtp)

  smtpHost     String? @map("smtp_host")
  smtpPort     Int?    @map("smtp_port")
  smtpUser     String? @map("smtp_user")
  smtpPassword String? @map("smtp_password")

  sesAccessKeyId     String? @map("ses_access_key_id")
  sesSecretAccessKey String? @map("ses_secret_access_key")
  sesRegion          String? @map("ses_region")

  resendApiKey String? @map("resend_api_key")

  fromAddress String? @map("from_address")
  fromName    String? @map("from_name")
  isActive    Boolean @default(false) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio    Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  templates EmailTemplate[]

  @@map("email_configs")
}

/// `bodyHtml` uses `{{variable}}` placeholders — deliberately a
/// different bracket convention from `WhatsAppTemplate`'s `{{1}}`
/// positional syntax, because it's following a different external
/// convention: Meta's numbered template parameters vs. the named-
/// variable convention nearly every HTML email templating tool uses.
/// `@bcp/notifications`' `renderEmailTemplate()` substitutes named
/// variables the same way `@bcp/whatsapp`'s `previewTemplate()`
/// substitutes positional ones — same idea, matched to each channel's
/// own convention rather than forcing one syntax on both.
model EmailTemplate {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid
  configId String? @map("config_id") @db.Uuid

  name       String
  subject    String
  bodyHtml   String   @map("body_html")
  variables  String[] @default([]) // named variables the template expects, e.g. ["clientName", "amount"]
  isActive   Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  studio   Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  config   EmailConfig?   @relation(fields: [configId], references: [id])
  messages EmailMessage[]

  @@unique([studioId, name])
  @@index([studioId])
  @@map("email_templates")
}

/// The full outbound email log — every email this platform sends
/// (quotations, invoices, receipts, reminders, notifications, ...)
/// creates one row, the same "one log for everything, linked by a
/// lightweight polymorphic contextType/contextId pair" convention
/// `WhatsAppMessage` already established. `bounced` is its own status,
/// distinct from `failed` — a bounce is Amazon SES/Resend telling the
/// platform an address is genuinely undeliverable (and a strong signal
/// to stop retrying that address), where `failed` covers everything
/// else (a transient send error, an unreachable SMTP host).
model EmailMessage {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid
  templateId String? @map("template_id") @db.Uuid

  toAddress   String  @map("to_address")
  subject     String
  bodyHtml    String  @map("body_html")
  variables   Json?
  attachmentKeys String[] @default([]) @map("attachment_keys") // @bcp/storage object keys

  contextType String? @map("context_type")
  contextId   String? @map("context_id") @db.Uuid

  status           EmailMessageStatus @default(queued)
  failureReason    String?            @map("failure_reason")
  providerMessageId String?           @map("provider_message_id")
  retryCount       Int                @default(0) @map("retry_count")

  queuedAt    DateTime  @default(now()) @map("queued_at")
  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  bouncedAt   DateTime? @map("bounced_at")
  failedAt    DateTime? @map("failed_at")

  sentBy String? @map("sent_by") @db.Uuid

  studio   Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  template EmailTemplate? @relation(fields: [templateId], references: [id])

  @@index([studioId])
  @@index([studioId, status])
  @@index([studioId, toAddress])
  @@index([providerMessageId])
  @@map("email_messages")
}

/// Per-email-address unsubscribe — simpler than `WhatsAppOptStatus`'s
/// three-state model because email has an industry-standard default
/// (allowed to send until an explicit unsubscribe) rather than
/// WhatsApp's stricter "never asked" middle state.
model EmailUnsubscribe {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  email          String
  unsubscribedAt DateTime @default(now()) @map("unsubscribed_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, email])
  @@index([studioId])
  @@map("email_unsubscribes")
}

/// One row per `StudioUser` — which of the 5 channels they want to
/// receive notifications on, at the granularity of "on or off per
/// channel," not per notification type. Matches `DashboardPreference`'s
/// "one JSON-backed preferences row per user" shape, extended here
/// with plain boolean columns instead of a JSON blob since there are
/// only 5 fixed channels to toggle, not an open-ended set that would
/// benefit from JSON's flexibility the way dashboard widget layout does.
model NotificationPreference {
  id           String @id @default(uuid()) @db.Uuid
  studioId     String @map("studio_id") @db.Uuid
  studioUserId String @unique @map("studio_user_id") @db.Uuid

  inAppEnabled       Boolean @default(true) @map("in_app_enabled")
  emailEnabled       Boolean @default(true) @map("email_enabled")
  whatsappEnabled    Boolean @default(false) @map("whatsapp_enabled")
  browserPushEnabled Boolean @default(false) @map("browser_push_enabled")
  pwaPushEnabled     Boolean @default(false) @map("pwa_push_enabled")

  updatedAt DateTime @updatedAt @map("updated_at")

  studio     Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("notification_preferences")
}

/// A registered Web Push subscription (browser or installed-PWA) for
/// one `StudioUser` on one device — a user with the app open on both
/// their phone and laptop has two rows, which is correct: push targets
/// a specific browser subscription, not a person.
model PushSubscription {
  id           String @id @default(uuid()) @db.Uuid
  studioId     String @map("studio_id") @db.Uuid
  studioUserId String @map("studio_user_id") @db.Uuid

  endpoint  String @unique
  p256dhKey String @map("p256dh_key")
  authKey   String @map("auth_key")
  userAgent String? @map("user_agent")
  isPwa     Boolean @default(false) @map("is_pwa") // true = installed PWA push, false = plain browser push

  createdAt DateTime @default(now()) @map("created_at")

  studio     Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  studioUser StudioUser @relation(fields: [studioUserId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([studioUserId])
  @@map("push_subscriptions")
}

// ═══════════════════════════════════════════════════════════════════════
// BULK PHOTO UPLOAD (Prompt 27)
// ═══════════════════════════════════════════════════════════════════════

enum UploadStatus {
  pending
  uploading
  paused
  processing // all chunks received, generating thumbnail/preview/web/EXIF/blur server-side
  completed
  failed
}

enum UploadChunkStatus {
  pending
  uploaded
  failed
}

/// One file's upload, from first byte to a finished `GalleryPhoto`.
/// Deliberately modeled as its own long-lived record rather than
/// something that only exists in browser memory — "persist queue
/// across reloads" in the brief means the *server* has to remember
/// what's in flight, not just the browser tab; a page refresh mid-
/// upload reconstructs its queue from `GET /upload-sessions`, not from
/// anything client-side. `checksum` is computed client-side (SHA-256
/// over the file) and sent before any bytes upload, so a duplicate is
/// caught *before* wasting bandwidth on a file the gallery already has.
model UploadSession {
  id        String @id @default(uuid()) @db.Uuid
  studioId  String @map("studio_id") @db.Uuid
  galleryId String @map("gallery_id") @db.Uuid

  fileName String @map("file_name")
  fileSize Int    @map("file_size") // bytes
  mimeType String @map("mime_type")
  checksum String // SHA-256, hex

  status        UploadStatus @default(pending)
  storageKey    String       @map("storage_key") // the destination object key, decided at session creation so chunk uploads target it from the start
  multipartUploadId String?  @map("multipart_upload_id") // S3's own multipart upload ID, once initiated
  chunkSize     Int          @map("chunk_size") // bytes per chunk, decided at session creation
  totalChunks   Int          @map("total_chunks")
  uploadedChunks Int         @default(0) @map("uploaded_chunks")

  preferWifi Boolean @default(false) @map("prefer_wifi") // client-reported preference, recorded for the studio's own visibility — network selection itself is inherently client-side, not enforceable server-side

  resultingPhotoId String? @map("resulting_photo_id") @db.Uuid
  failureReason     String? @map("failure_reason")
  retryCount        Int     @default(0) @map("retry_count")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  createdBy   String?   @map("created_by") @db.Uuid

  studio  Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  gallery Gallery       @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  chunks  UploadChunk[]

  @@index([studioId])
  @@index([galleryId])
  @@index([galleryId, checksum])
  @@index([galleryId, status])
  @@map("upload_sessions")
}

/// One chunk of one upload — `etag` is what S3's multipart API returns
/// per part and requires back when completing the upload, so it's
/// stored the moment a part succeeds rather than re-derived later.
model UploadChunk {
  id              String @id @default(uuid()) @db.Uuid
  uploadSessionId String @map("upload_session_id") @db.Uuid

  chunkIndex Int               @map("chunk_index")
  sizeBytes  Int               @map("size_bytes")
  status     UploadChunkStatus @default(pending)
  etag       String?

  uploadedAt DateTime? @map("uploaded_at")

  uploadSession UploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)

  @@unique([uploadSessionId, chunkIndex])
  @@index([uploadSessionId])
  @@map("upload_chunks")
}

// ═══════════════════════════════════════════════════════════════════════
// AI FACE RECOGNITION (Prompt 28)
// ═══════════════════════════════════════════════════════════════════════

enum FaceCollectionStatus {
  active
  building
  failed
}

enum FaceSearchMode {
  live_scan
  selfie_upload
}

enum FaceSearchStatus {
  pending
  detecting
  searching
  completed
  no_match
  failed
}

/// One AWS Rekognition "collection" per gallery — never per studio,
/// never shared across galleries. This is what structurally enforces
/// "no cross-studio search" and "no unauthorized cross-event search":
/// a guest's face search can only ever query the one collection tied
/// to the gallery they're actually in, because that's the only
/// collection ID the search code path ever has access to. There is no
/// function anywhere in `@bcp/face-recognition`/`apps/api` that
/// accepts a collection ID from outside the current gallery's own
/// record.
model FaceCollection {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  galleryId String @unique @map("gallery_id") @db.Uuid

  providerCollectionId String               @unique @map("provider_collection_id") // Rekognition's own CollectionId
  status                FaceCollectionStatus @default(building)

  createdAt DateTime @default(now()) @map("created_at")

  studio  Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  gallery Gallery        @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  entries FaceIndexEntry[]

  @@index([studioId])
  @@map("face_collections")
}

/// One detected+indexed face within one delivered gallery photo — a
/// group photo with 5 people produces 5 rows, one per face, each with
/// Rekognition's own `providerFaceId` (what a search actually matches
/// against) and the face's bounding box for potential UI highlighting.
model FaceIndexEntry {
  id               String @id @default(uuid()) @db.Uuid
  faceCollectionId String @map("face_collection_id") @db.Uuid
  galleryPhotoId   String @map("gallery_photo_id") @db.Uuid

  providerFaceId String @unique @map("provider_face_id")
  boundingBox    Json   @map("bounding_box")
  confidence     Float

  indexedAt DateTime @default(now()) @map("indexed_at")

  faceCollection FaceCollection @relation(fields: [faceCollectionId], references: [id], onDelete: Cascade)
  galleryPhoto   GalleryPhoto   @relation(fields: [galleryPhotoId], references: [id], onDelete: Cascade)

  @@index([faceCollectionId])
  @@index([galleryPhotoId])
  @@map("face_index_entries")
}

/// One guest's face-search attempt — the record that outlives the
/// selfie itself. `selfieDeletedAt` being non-null is the system's own
/// proof the temporary selfie was actually deleted, not just an
/// assumption; `apps/api`'s search flow sets it in the same operation
/// that deletes the object from storage, never as a separate step that
/// could be skipped. `consentedAt` must be set before a session can
/// reach `detecting` — see `@bcp/face-recognition`'s
/// `assertConsentedBeforeSearch()`.
model FaceSearchSession {
  id        String @id @default(uuid()) @db.Uuid
  studioId  String @map("studio_id") @db.Uuid
  galleryId String @map("gallery_id") @db.Uuid

  guestToken String         @map("guest_token")
  mode       FaceSearchMode
  status     FaceSearchStatus @default(pending)

  consentedAt DateTime? @map("consented_at")

  detectedFaceCount Int     @default(0) @map("detected_face_count")
  lowLightWarning   Boolean @default(false) @map("low_light_warning")
  confidenceThreshold Int   @map("confidence_threshold") // snapshot of the gallery's setting at search time, so a later settings change doesn't retroactively reinterpret past results

  failureReason String? @map("failure_reason")

  selfieDeletedAt DateTime? @map("selfie_deleted_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  studio  Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  gallery Gallery             @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  matches FaceSearchMatch[]

  @@index([studioId])
  @@index([galleryId])
  @@index([galleryId, guestToken])
  @@map("face_search_sessions")
}

/// One matched photo for one search session. `manuallyCorrected`
/// covers "Manual correction" from the brief — a guest (or the studio,
/// reviewing on their behalf) marking a suggested match as wrong,
/// without that correction ever retraining or mutating the underlying
/// face index.
model FaceSearchMatch {
  id                  String @id @default(uuid()) @db.Uuid
  faceSearchSessionId String @map("face_search_session_id") @db.Uuid
  galleryPhotoId      String @map("gallery_photo_id") @db.Uuid

  confidence        Float
  manuallyCorrected Boolean @default(false) @map("manually_corrected")

  createdAt DateTime @default(now()) @map("created_at")

  faceSearchSession FaceSearchSession @relation(fields: [faceSearchSessionId], references: [id], onDelete: Cascade)
  galleryPhoto      GalleryPhoto      @relation(fields: [galleryPhotoId], references: [id], onDelete: Cascade)

  @@unique([faceSearchSessionId, galleryPhotoId])
  @@index([faceSearchSessionId])
  @@map("face_search_matches")
}

/// An append-only consent record — "Consent must be recorded" and
/// "Privacy logs" from the brief, in one model. Never updated after
/// creation, never deleted by the retention purge that clears out old
/// `FaceSearchSession`s, since a consent record is itself the
/// compliance evidence a studio needs to keep regardless of how long
/// the search session it belongs to is retained.
model FaceConsentLog {
  id        String @id @default(uuid()) @db.Uuid
  studioId  String @map("studio_id") @db.Uuid
  galleryId String @map("gallery_id") @db.Uuid

  guestToken  String @map("guest_token")
  consentText String @map("consent_text") // snapshot of the privacy notice actually shown, so a later copy change doesn't retroactively reinterpret what was consented to

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  consentedAt DateTime @default(now()) @map("consented_at")

  studio  Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([galleryId])
  @@map("face_consent_logs")
}

// ═══════════════════════════════════════════════════════════════════════
// ADVANCED AI PHOTO INTELLIGENCE (Prompt 29)
// ═══════════════════════════════════════════════════════════════════════

enum AnalysisReviewStatus {
  pending
  approved
  rejected
}

enum ExposureAssessment {
  underexposed
  good
  overexposed
}

enum DuplicateGroupType {
  exact_duplicate
  near_duplicate
}

enum PhotoReviewAction {
  approved
  rejected
  undone
}

/// One row per analyzed `GalleryPhoto` — every quality and content
/// metric the brief names lives here, computed once by
/// `@bcp/photo-intelligence`'s analysis pipeline and never
/// recalculated on read. `status`/`reviewedBy`/`reviewedAt` is the
/// studio's own approve/reject verdict on the AI's assessment as a
/// whole — approving or rejecting **never** touches `GalleryPhoto`
/// itself (no auto-hide, no auto-delete); a studio acting on a
/// confirmed "blurry" flag is a separate, deliberate step through the
/// existing photo-management actions from Prompt 26. `confidence` and
/// `explanation` are the two fields "every AI result must provide,"
/// applied here at the whole-analysis level rather than duplicated
/// per individual metric.
model PhotoAnalysis {
  id             String @id @default(uuid()) @db.Uuid
  studioId       String @map("studio_id") @db.Uuid
  galleryPhotoId String @unique @map("gallery_photo_id") @db.Uuid

  // Technical quality
  blurScore      Float // 0-100, higher = sharper
  isBlurry       Boolean @map("is_blurry")
  sharpnessScore Float   @map("sharpness_score")
  noiseScore     Float   @map("noise_score") // 0-100, higher = noisier
  exposureScore  Float   @map("exposure_score") // 0-100, distance from ideal exposure
  exposureAssessment ExposureAssessment @map("exposure_assessment")

  // Content
  faceCount            Int     @default(0) @map("face_count")
  closedEyeDetected     Boolean @default(false) @map("closed_eye_detected")
  smileDetected         Boolean @default(false) @map("smile_detected")
  isGroupPhoto          Boolean @default(false) @map("is_group_photo") // faceCount above the gallery's configured group-photo threshold
  subjectProminenceScore Float  @map("subject_prominence_score") // 0-100 — how much the main subject stands out from the background/frame
  sceneClassification    String? @map("scene_classification") // free text label, e.g. "outdoor_ceremony", "reception_dancefloor"
  momentTags             String[] @default([]) @map("moment_tags") // e.g. ["first_kiss", "ring_exchange"] — studio-defined vocabulary, not a fixed enum

  // Composite
  compositionScore Float @map("composition_score") // 0-100
  qualityScore     Float @map("quality_score") // 0-100 overall — the single number a "best shots" sort/filter uses

  confidence  Float // 0-100 — the AI's own confidence in this analysis as a whole
  explanation String // human-readable reasoning, always populated — "every AI result must provide ... explanation"

  status       AnalysisReviewStatus @default(pending)
  reviewedByUserId String?          @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?        @map("reviewed_at")

  analyzedAt DateTime @default(now()) @map("analyzed_at")

  studio      Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  galleryPhoto GalleryPhoto      @relation(fields: [galleryPhotoId], references: [id], onDelete: Cascade)
  reviewLogs  PhotoAnalysisReviewLog[]

  @@index([studioId])
  @@index([galleryPhotoId])
  @@map("photo_analyses")
}

/// The undo-capable audit trail behind approve/reject — every state
/// change appends one row rather than overwriting `PhotoAnalysis.status`
/// blindly, so "Undo" is simply "restore `previousStatus` from the most
/// recent log entry," not a guess. `batchId` groups the rows a single
/// "Bulk review" action created, so a bulk approve of 40 photos shows
/// as one undoable operation in the UI, not 40 separate ones.
model PhotoAnalysisReviewLog {
  id              String @id @default(uuid()) @db.Uuid
  studioId        String @map("studio_id") @db.Uuid
  photoAnalysisId String @map("photo_analysis_id") @db.Uuid

  action         PhotoReviewAction
  previousStatus AnalysisReviewStatus @map("previous_status")
  newStatus      AnalysisReviewStatus @map("new_status")
  batchId        String?              @map("batch_id") @db.Uuid // shared across every row one bulk-review call created

  actorId   String   @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  studio        Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  photoAnalysis PhotoAnalysis @relation(fields: [photoAnalysisId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([photoAnalysisId])
  @@index([batchId])
  @@map("photo_analysis_review_logs")
}

/// One cluster of exact or near-duplicate photos within a gallery —
/// "Duplicate detection" and "Near-duplicate grouping" from the brief,
/// unified into one model since they differ only in `groupType` and
/// the similarity-score range that produced them. Reviewable the same
/// way `PhotoAnalysis` is (approve = "yes these are duplicates,"
/// reject = "no, these are actually different shots") — approving
/// **never** deletes or hides any member photo automatically.
model DuplicateGroup {
  id        String @id @default(uuid()) @db.Uuid
  studioId  String @map("studio_id") @db.Uuid
  galleryId String @map("gallery_id") @db.Uuid

  groupType DuplicateGroupType @map("group_type")

  confidence  Float
  explanation String

  status           AnalysisReviewStatus @default(pending)
  reviewedByUserId String?              @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?            @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")

  studio  Studio                  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  gallery Gallery                 @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  members DuplicateGroupMember[]

  @@index([studioId])
  @@index([galleryId])
  @@map("duplicate_groups")
}

/// `isBestShot` is "Best-shot suggestion" scoped to within one
/// duplicate/near-duplicate cluster — the most concrete, directly
/// actionable reading of that feature (picking the keeper among near-
/// identical frames). A gallery-wide "best shots of the event" view is
/// just `PhotoAnalysis.qualityScore` sorted descending; it doesn't need
/// its own model.
model DuplicateGroupMember {
  id               String @id @default(uuid()) @db.Uuid
  duplicateGroupId String @map("duplicate_group_id") @db.Uuid
  galleryPhotoId   String @map("gallery_photo_id") @db.Uuid

  similarityScore Float   @map("similarity_score") // 0-100, relative to the group's representative photo
  isBestShot      Boolean @default(false) @map("is_best_shot")

  duplicateGroup DuplicateGroup @relation(fields: [duplicateGroupId], references: [id], onDelete: Cascade)
  galleryPhoto   GalleryPhoto   @relation(fields: [galleryPhotoId], references: [id], onDelete: Cascade)

  @@unique([duplicateGroupId, galleryPhotoId])
  @@index([duplicateGroupId])
  @@index([galleryPhotoId])
  @@map("duplicate_group_members")
}

// ═══════════════════════════════════════════════════════════════════════
// AI CULLING & ALBUM SUGGESTIONS (Prompt 30)
// ═══════════════════════════════════════════════════════════════════════

enum CullingPresetType {
  wedding
  engagement
  baby
  maternity
  birthday
  corporate
  school
}

enum CullingSessionStatus {
  pending
  running
  completed
  failed
}

enum CullingRecommendationType {
  include
  exclude
  review // the AI itself is unsure — not confident enough to recommend either way
}

enum CullingReviewStatus {
  pending
  approved
  rejected
}

/// One AI-assisted culling run for a gallery. `priorityWeights` is a
/// snapshot of the weight configuration actually used — either a
/// preset's defaults (`@bcp/culling`'s `CULLING_PRESETS`) or a
/// studio's own manual adjustment on top of one — captured here rather
/// than only referencing a preset by name, so a later change to a
/// preset's defaults never retroactively reinterprets a past session's
/// results. Re-running with different weights creates a **new**
/// session rather than mutating this one, the same "never overwrite,
/// always append a new record" instinct `PhotoAnalysisReviewLog`
/// already established for review history.
model CullingSession {
  id        String @id @default(uuid()) @db.Uuid
  studioId  String @map("studio_id") @db.Uuid
  galleryId String @map("gallery_id") @db.Uuid

  presetType CullingPresetType @map("preset_type")
  priorityWeights Json         @map("priority_weights") // {technicalQuality, emotionalMoments, peopleBalance, poseVariety} — see @bcp/culling's PriorityWeights
  importantFaceIds String[]    @default([]) @map("important_face_ids") // provider face IDs (FaceIndexEntry.providerFaceId) the studio flagged as VIPs (e.g. the couple) — "Identify important people"; empty means auto-detect by frequency

  status       CullingSessionStatus @default(pending)
  failureReason String?             @map("failure_reason")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  createdBy   String?   @map("created_by") @db.Uuid

  studio          Studio                  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  gallery         Gallery                 @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  recommendations CullingRecommendation[]

  @@index([studioId])
  @@index([galleryId])
  @@map("culling_sessions")
}

/// One photo's culling verdict within one session. `recommendation`
/// is the AI's own three-way read (`include`/`exclude`/`review` for
/// "not confident enough either way"); `status` is the studio's
/// separate approve/reject verdict on that recommendation — the same
/// two-layer shape (AI says X, studio confirms/overrides) established
/// in Prompt 29. Rejecting an `exclude` recommendation is exactly how
/// "Protect emotional moments" stays a genuine safeguard rather than a
/// suggestion with no teeth: a studio overriding the AI is the whole
/// point, not an edge case.
model CullingRecommendation {
  id               String @id @default(uuid()) @db.Uuid
  cullingSessionId String @map("culling_session_id") @db.Uuid
  galleryPhotoId   String @map("gallery_photo_id") @db.Uuid

  recommendation CullingRecommendationType
  confidence     Float
  reason         String

  technicalIssues  String[] @default([]) @map("technical_issues") // e.g. ["blurry", "closed_eyes"] — sourced from PhotoAnalysis, not re-detected here
  isEmotionalMoment Boolean @default(false) @map("is_emotional_moment") // "Protect emotional moments" — true suppresses an exclude recommendation regardless of technical score, see @bcp/culling's applyEmotionalProtection()
  isRepeatedPose    Boolean @default(false) @map("is_repeated_pose") // "Avoid repeated poses" — flagged when near-identical framing/pose already has an included representative

  status CullingReviewStatus @default(pending)

  cullingSession CullingSession @relation(fields: [cullingSessionId], references: [id], onDelete: Cascade)
  galleryPhoto   GalleryPhoto   @relation(fields: [galleryPhotoId], references: [id], onDelete: Cascade)

  @@unique([cullingSessionId, galleryPhotoId])
  @@index([cullingSessionId])
  @@index([galleryPhotoId])
  @@map("culling_recommendations")
}

/// One AI-generated album proposal — which photos, in what order,
/// with which cover. Kept as its own model rather than folded into
/// `CullingSession` because culling (what's worth keeping at all) and
/// album assembly (which keepers go in *this specific printed/digital
/// album*, and in what sequence) are genuinely different decisions — a
/// studio might cull once and generate several different album
/// proposals from the surviving photos (a full album vs. a parent
/// album vs. a highlights album).
model AlbumSuggestion {
  id        String @id @default(uuid()) @db.Uuid
  studioId  String @map("studio_id") @db.Uuid
  galleryId String @map("gallery_id") @db.Uuid

  presetType     CullingPresetType @map("preset_type")
  targetPhotoCount Int             @map("target_photo_count")

  status CullingSessionStatus @default(pending)
  failureReason String?       @map("failure_reason")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  createdBy   String?   @map("created_by") @db.Uuid

  studio  Studio                 @relation(fields: [studioId], references: [id], onDelete: Cascade)
  gallery Gallery                @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photos  AlbumSuggestionPhoto[]

  @@index([studioId])
  @@index([galleryId])
  @@map("album_suggestions")
}

/// One photo's place within an album suggestion. `sequenceOrder` is
/// "Suggest album sequence"; `isCoverRecommendation` is "Recommend
/// cover" (at most one `true` per suggestion, enforced in
/// `apps/api`, not the schema, the same way `Gallery.coverPhotoId`
/// elsewhere is a single pointer rather than a schema constraint).
/// `momentCategory` is what "Balance people and rituals" actually
/// balances *across* — e.g. ensuring the sequence isn't all ceremony
/// shots with no reception, all one person with no group shots.
model AlbumSuggestionPhoto {
  id                String @id @default(uuid()) @db.Uuid
  albumSuggestionId String @map("album_suggestion_id") @db.Uuid
  galleryPhotoId    String @map("gallery_photo_id") @db.Uuid

  sequenceOrder         Int     @map("sequence_order")
  isCoverRecommendation Boolean @default(false) @map("is_cover_recommendation")
  momentCategory        String? @map("moment_category")
  reason                String
  confidence            Float

  status CullingReviewStatus @default(pending)

  albumSuggestion AlbumSuggestion @relation(fields: [albumSuggestionId], references: [id], onDelete: Cascade)
  galleryPhoto    GalleryPhoto    @relation(fields: [galleryPhotoId], references: [id], onDelete: Cascade)

  @@unique([albumSuggestionId, galleryPhotoId])
  @@index([albumSuggestionId])
  @@index([galleryPhotoId])
  @@map("album_suggestion_photos")
}

// ═══════════════════════════════════════════════════════════════════════
// ALBUM DESIGN & 3D E-ALBUM (Prompt 32)
// ═══════════════════════════════════════════════════════════════════════

enum AlbumSpreadStatus {
  draft
  proof
  approved
  revision_requested
}

/// One two-page spread, versioned. `spreadNumber` identifies the
/// position in the album; `versionNumber` increments every re-upload
/// of that same spread — "Spread upload" and "Versioning" are the same
/// mechanism, not two features. Only one version per `spreadNumber` is
/// ever `isCurrent`, resolved in `apps/api`'s upload service (the
/// moment a new version uploads, the previous one's flag flips off in
/// the same transaction) rather than being derivable from
/// `versionNumber` alone, since a studio reverting to an earlier
/// version is a real, if unusual, action this needs to support without
/// deleting the newer one.
model AlbumSpread {
  id      String @id @default(uuid()) @db.Uuid
  albumId String @map("album_id") @db.Uuid

  spreadNumber  Int @map("spread_number")
  versionNumber Int @map("version_number")
  isCurrent     Boolean @default(true) @map("is_current")

  fileKey String @map("file_key")
  status  AlbumSpreadStatus @default(draft)

  uploadedAt DateTime @default(now()) @map("uploaded_at")
  uploadedBy String?  @map("uploaded_by") @db.Uuid

  album       Album                 @relation(fields: [albumId], references: [id], onDelete: Cascade)
  comments    AlbumSpreadComment[]
  approvals   AlbumSpreadApproval[]

  @@unique([albumId, spreadNumber, versionNumber])
  @@index([albumId])
  @@index([albumId, spreadNumber])
  @@map("album_spreads")
}

/// "Page comments" and "Annotation" are the same model with an
/// optional pin position — `positionX`/`positionY` (0-1 normalized
/// coordinates within the page) set means a pinned annotation on a
/// specific spot; left null means a general comment about the page as
/// a whole. No separate annotation model, since an annotation is
/// structurally just a comment that happens to know where on the page
/// it's pointing.
model AlbumSpreadComment {
  id            String @id @default(uuid()) @db.Uuid
  albumSpreadId String @map("album_spread_id") @db.Uuid

  body      String
  positionX Float?  @map("position_x")
  positionY Float?  @map("position_y")

  authorType String  @map("author_type") // "studio" | "client"
  guestToken String? @map("guest_token") // set when authorType is "client"
  resolvedAt DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  albumSpread AlbumSpread @relation(fields: [albumSpreadId], references: [id], onDelete: Cascade)

  @@index([albumSpreadId])
  @@map("album_spread_comments")
}

enum AlbumSpreadApprovalStatus {
  approved
  revision_requested
}

/// "Page approval" — a client's verdict on one specific spread
/// version, distinct from "Full album approval"
/// (`Album.fullyApprovedAt`), which requires every current spread to
/// be approved first (enforced in `apps/api`, not the schema — see
/// `@bcp/album-production`'s `canApproveFullAlbum()`).
model AlbumSpreadApproval {
  id            String @id @default(uuid()) @db.Uuid
  albumSpreadId String @map("album_spread_id") @db.Uuid

  status     AlbumSpreadApprovalStatus
  comment    String?
  guestToken String @map("guest_token")

  createdAt DateTime @default(now()) @map("created_at")

  albumSpread AlbumSpread @relation(fields: [albumSpreadId], references: [id], onDelete: Cascade)

  @@index([albumSpreadId])
  @@map("album_spread_approvals")
}

/// One revision round — "Revision requested" as a pipeline stage
/// (`Album.productionStage`) is the *current* state; this is the full
/// history of every round requested, which is what "Revision limits"
/// actually counts against (`@bcp/album-production`'s
/// `countRevisionRounds()` / `hasReachedRevisionLimit()`).
model AlbumRevisionRequest {
  id      String @id @default(uuid()) @db.Uuid
  albumId String @map("album_id") @db.Uuid

  roundNumber Int    @map("round_number")
  notes       String
  guestToken  String @map("guest_token")

  requestedAt DateTime @default(now()) @map("requested_at")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@map("album_revision_requests")
}

/// A viewer's verified access to the 3D e-album — kept separate from
/// `AlbumAccessSession` (Prompt 31's *selection* link) since the
/// e-album is a different link, delivered at a different point in the
/// album's lifecycle, potentially shared far more widely (the brief
/// names WhatsApp share specifically) than a selection link ever
/// would be.
model EAlbumAccessSession {
  id      String @id @default(uuid()) @db.Uuid
  albumId String @map("album_id") @db.Uuid

  guestToken String  @unique @map("guest_token")
  passwordVerified Boolean @default(false) @map("password_verified")
  otpCode      String?   @map("otp_code")
  otpExpiresAt DateTime? @map("otp_expires_at")
  otpVerified  Boolean   @default(false) @map("otp_verified")

  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@map("e_album_access_sessions")
}

// ═══════════════════════════════════════════════════════════════════════
// CLIENT PORTAL (Prompt 33)
// ═══════════════════════════════════════════════════════════════════════

/// A client's authenticated portal session — OTP-based login (a code
/// sent to the client's own email or phone, the same "no password to
/// manage" pattern every other guest-adjacent flow in this codebase
/// already uses), but unlike `GalleryAccessSession`/`AlbumAccessSession`
/// (each scoped to *one* gallery or album), this is scoped to the
/// `Client` record itself — one login gives access to everything that
/// client has across the whole studio relationship: every booking,
/// quotation, invoice, gallery, and album tied to their `clientId`.
model ClientPortalSession {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  sessionToken String  @unique @map("session_token")
  otpCode      String? @map("otp_code")
  otpExpiresAt DateTime? @map("otp_expires_at")
  otpVerified  Boolean @default(false) @map("otp_verified")

  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at") // session lifetime, independent of OTP expiry
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([clientId])
  @@map("client_portal_sessions")
}

/// "Raise support request" — a lightweight ticket a client opens from
/// inside the portal, distinct from `ClientCommunication` (Prompt 12's
/// manually-logged call/email/meeting history a studio records on a
/// client's behalf) since this is client-initiated and has its own
/// status lifecycle a studio actively works through. Named
/// `ClientSupportRequest` (not `SupportRequest`) specifically to avoid
/// colliding with the already-existing `SupportRequest` model, which is
/// an entirely different relationship — a *studio's own* ticket to the
/// *platform*, not a client's ticket to their studio. Reuses that
/// model's `SupportRequestStatus` enum directly, since the same
/// open/in_progress/resolved/closed lifecycle applies equally well
/// here.
model ClientSupportRequest {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  subject String
  message String
  status  SupportRequestStatus @default(open)

  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by") @db.Uuid

  studio  Studio                       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client  Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  replies ClientSupportRequestReply[]

  @@index([studioId])
  @@index([clientId])
  @@index([studioId, status])
  @@map("client_support_requests")
}

model ClientSupportRequestReply {
  id               String @id @default(uuid()) @db.Uuid
  supportRequestId String @map("support_request_id") @db.Uuid

  body       String
  authorType String  @map("author_type") // "client" | "studio"
  authorId   String? @map("author_id") @db.Uuid // set when authorType is "studio"

  createdAt DateTime @default(now()) @map("created_at")

  supportRequest ClientSupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)

  @@index([supportRequestId])
  @@map("client_support_request_replies")
}

// ═══════════════════════════════════════════════════════════════════════
// CONTRACTS & E-SIGNATURE (Prompt 34)
// ═══════════════════════════════════════════════════════════════════════

/// "Allow each studio to manage its own templates" — one row per
/// reusable contract template. `sections` is an ordered JSON array
/// (`{ type, title, content }`) rather than fixed columns for payment/
/// cancellation/delivery/copyright/model-release/privacy-consent
/// terms — the brief names these as the *suggested* clause types
/// (`@bcp/contracts`' `CONTRACT_CLAUSE_TYPES`), but a studio's actual
/// contract is free-form legal text a studio owner or lawyer writes
/// and reorders, not data that fits six dedicated text columns.
/// `variables` is the named-placeholder convention `EmailTemplate`
/// already established (`{{variableName}}`, matching HTML-templating
/// norms) — "Event details" (date, venue, package) are simply the
/// variables a studio's own template chooses to reference, not a
/// separately modeled concept.
model ContractTemplate {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  name       String
  category   String? // e.g. "wedding", "corporate" — free text, studio-defined
  sections   Json     // [{ type: "payment_terms" | ..., title, content }]
  variables  String[] @default([])
  isActive   Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio    Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  contracts ClientContract[]

  @@unique([studioId, name])
  @@index([studioId])
  @@map("contract_templates")
}

/// "Version history" — an append-only snapshot every time a
/// contract's content changes (generated from a template, edited
/// before sending, or regenerated after a requested revision).
/// `ClientContract.currentVersionNumber` always points at the latest
/// row here; nothing is ever overwritten, so a studio (or an auditor)
/// can always see exactly what a client was looking at when they
/// signed, even if the template changed afterward.
model ContractVersion {
  id         String @id @default(uuid()) @db.Uuid
  contractId String @map("contract_id") @db.Uuid

  versionNumber  Int    @map("version_number")
  bodyHtml       String @map("body_html") // the fully-rendered contract text at this version, variables already substituted
  variableValues Json?  @map("variable_values")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  contract ClientContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, versionNumber])
  @@index([contractId])
  @@map("contract_versions")
}

enum ContractAuditAction {
  created
  sent
  viewed
  otp_requested
  otp_verified
  signed
  witnessed
  certificate_generated
  revision_requested
  voided
}

/// "Audit trail" — every step of a contract's life, independent of
/// `ContractVersion` (which only captures *content* changes). Never
/// updated or deleted once written; this is the record a studio points
/// to if a signature's validity is ever questioned.
model ContractAuditLogEntry {
  id         String @id @default(uuid()) @db.Uuid
  contractId String @map("contract_id") @db.Uuid

  action    ContractAuditAction
  actorType String              @map("actor_type") // "studio" | "client" | "witness"
  ipAddress String?             @map("ip_address")
  userAgent String?             @map("user_agent")
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at")

  contract ClientContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([contractId, createdAt])
  @@map("contract_audit_log_entries")
}

// ═══════════════════════════════════════════════════════════════════════
// PRINT PRODUCTS & COMMERCE (Prompt 35)
// ═══════════════════════════════════════════════════════════════════════

enum ProductCategory {
  softcopy
  print
  album
  frame
  canvas
  acrylic
  calendar
  photo_book
  gift
}

/// A studio's own sellable product — softcopies through gift products,
/// the 9 categories named in the brief. Base pricing lives here;
/// `ProductVariant` is where "Size"/"Finish"/"Quantity" tiers each get
/// their own price, since a product itself (e.g. "Canvas Print") is
/// really a family of purchasable variants, not one fixed price point.
model Product {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  category    ProductCategory
  name        String
  description String?
  basePriceInPaise Int         @map("base_price_in_paise")
  isActive    Boolean         @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio   Studio                @relation(fields: [studioId], references: [id], onDelete: Cascade)
  variants ProductVariant[]
  eventPricing EventProductPricing[]
  orderItems   CommerceOrderItem[]

  @@index([studioId])
  @@index([studioId, category])
  @@map("products")
}

/// "Size" / "Finish" / "Quantity" — one row per purchasable
/// combination of a product, each with its own price (e.g. an 8x10
/// matte print is priced independently from a 16x20 glossy canvas,
/// even though both derive from the same underlying `Product`).
/// `quantityTier` covers bulk pricing (e.g. "set of 10") as a labeled
/// variant rather than a separate discount mechanism.
model ProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid

  size         String?
  finish       String?
  quantityTier String? @map("quantity_tier")
  sku          String?
  priceInPaise Int     @map("price_in_paise")
  isActive     Boolean @default(true) @map("is_active")

  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  eventPricing EventProductPricing[]
  orderItems   CommerceOrderItem[]

  @@index([productId])
  @@map("product_variants")
}

/// "Event-specific pricing" — a per-event override on top of a
/// product's (or one of its variants') standard price, e.g. prints
/// bundled into a wedding package at a discounted rate that wouldn't
/// apply to a birthday shoot. `variantId` null means the override
/// applies to the product's base price; set means it's scoped to one
/// specific variant.
model EventProductPricing {
  id        String  @id @default(uuid()) @db.Uuid
  studioId  String  @map("studio_id") @db.Uuid
  eventId   String  @map("event_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid

  overridePriceInPaise Int @map("override_price_in_paise")

  studio  Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  event   Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([eventId, productId, variantId])
  @@index([studioId])
  @@index([eventId])
  @@map("event_product_pricing")
}

enum CouponDiscountType {
  percentage
  fixed_amount
}

/// "Coupons" — a studio's own promotional codes, entirely independent
/// of the platform (never a platform-wide coupon), consistent with
/// this codebase's "each studio manages its own X" pattern already
/// established for contract templates, email/WhatsApp templates, and
/// culling presets.
model Coupon {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  code               String
  discountType       CouponDiscountType @map("discount_type")
  discountValue      Float              @map("discount_value")
  appliesToCategory  ProductCategory?   @map("applies_to_category") // null = applies to any product
  maxUses            Int?               @map("max_uses") // null = unlimited
  usedCount          Int                @default(0) @map("used_count")
  validFrom          DateTime?          @map("valid_from")
  validUntil         DateTime?          @map("valid_until")
  isActive           Boolean            @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  studio Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  orders CommerceOrder[]

  @@unique([studioId, code])
  @@index([studioId])
  @@map("coupons")
}

enum CommerceOrderStatus {
  pending
  paid
  processing
  fulfilled
  shipped
  delivered
  cancelled
}

enum CommercePaymentMethod {
  online
  manual
}

/// One client's purchase — softcopies through gift products, one or
/// more line items each. `platformCommissionPercent`/
/// `platformCommissionPaise` snapshot whatever
/// `PlatformCommerceSettings` said at the moment the order was placed
/// (0 by default, per the brief) — a later platform-wide fee change
/// never retroactively reinterprets an already-placed order's
/// economics, the same "snapshot, don't just reference" instinct
/// `CullingSession.priorityWeights` and `Invoice.gstRatePercent`
/// already established elsewhere in this codebase.
model CommerceOrder {
  id       String  @id @default(uuid()) @db.Uuid
  studioId String  @map("studio_id") @db.Uuid
  clientId String  @map("client_id") @db.Uuid
  eventId  String? @map("event_id") @db.Uuid
  galleryId String? @map("gallery_id") @db.Uuid // the source gallery these photos are being ordered from, when applicable

  orderNumber String              @map("order_number")
  status      CommerceOrderStatus @default(pending)

  subtotalPaise Int @map("subtotal_paise")
  discountPaise Int @default(0) @map("discount_paise")
  shippingPaise Int @default(0) @map("shipping_paise")
  taxPaise      Int @default(0) @map("tax_paise")
  totalPaise    Int @map("total_paise")

  platformCommissionPercent Float @default(0) @map("platform_commission_percent")
  platformCommissionPaise   Int   @default(0) @map("platform_commission_paise")

  couponId String? @map("coupon_id") @db.Uuid

  shippingName        String? @map("shipping_name")
  shippingAddressLine1 String? @map("shipping_address_line1")
  shippingAddressLine2 String? @map("shipping_address_line2")
  shippingCity         String? @map("shipping_city")
  shippingState        String? @map("shipping_state")
  shippingPostalCode   String? @map("shipping_postal_code")
  shippingPhone        String? @map("shipping_phone")

  courierName    String?   @map("courier_name")
  trackingNumber String?   @map("tracking_number")
  dispatchedAt   DateTime? @map("dispatched_at")
  deliveredAt    DateTime? @map("delivered_at")

  paymentMethod CommercePaymentMethod? @map("payment_method")

  labExportedAt DateTime? @map("lab_exported_at") // "Lab export" — when the order's fulfilment file was generated for the print lab

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studio  Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client  Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  event   Event?          @relation(fields: [eventId], references: [id])
  gallery Gallery?        @relation(fields: [galleryId], references: [id])
  coupon  Coupon?         @relation(fields: [couponId], references: [id])
  items    CommerceOrderItem[]
  payments CommercePayment[]

  @@unique([studioId, orderNumber])
  @@index([studioId])
  @@index([clientId])
  @@index([studioId, status])
  @@map("commerce_orders")
}

/// One product/variant within an order — `galleryPhotoId` ties a print/
/// canvas/frame/acrylic line item to the specific photo it's made
/// from; left null for items that aren't photo-specific (e.g. a gift
/// voucher). "Original download for lab fulfilment" reads this photo
/// reference to resolve which `GalleryPhoto.fileKey` the lab actually
/// needs.
model CommerceOrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  galleryPhotoId String? @map("gallery_photo_id") @db.Uuid

  quantity       Int @default(1)
  unitPricePaise Int @map("unit_price_paise")
  totalPaise     Int @map("total_paise")

  order   CommerceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  galleryPhoto GalleryPhoto? @relation(fields: [galleryPhotoId], references: [id])

  @@index([orderId])
  @@map("commerce_order_items")
}

enum CommercePaymentStatus {
  pending
  completed
  failed
  refunded
}

/// A payment attempt against a `CommerceOrder` — its own model rather
/// than reusing `ClientPayment` (which is scoped to `Invoice`), since a
/// commerce purchase is a separate transaction type from an invoice
/// payment even when the same client and the same gateway are
/// involved. "Online payment" and "Manual payment" are both just a
/// `method` value here — the same razorpay/cashfree/cash/UPI/etc
/// vocabulary `PaymentMethod` already established for invoices, not a
/// second parallel enum.
model CommercePayment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  amountPaise Int            @map("amount_paise")
  method      PaymentMethod
  status      CommercePaymentStatus @default(pending)

  gatewayProvider      String? @map("gateway_provider")
  gatewayTransactionId String? @map("gateway_transaction_id")

  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")

  order CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("commerce_payments")
}

/// Platform-wide commerce settings — a genuine singleton (one row,
/// enforced by always querying/upserting the same well-known ID in
/// `apps/api`, the same convention this codebase would use for any
/// singleton config rather than a special schema constraint).
/// `commissionPercent` defaults to 0 and `commissionEnabled` to
/// false — "zero platform commission by default," with the field
/// already in place and load-bearing (not a placeholder) the moment a
/// platform admin wants to turn it on, which is what "keep future
/// platform fee support configurable" actually asks for: the capability
/// to exist now, not to be exercised now.
model PlatformCommerceSettings {
  id                String  @id @default(uuid()) @db.Uuid
  commissionEnabled Boolean @default(false) @map("commission_enabled")
  commissionPercent Float   @default(0) @map("commission_percent")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_commerce_settings")
}

// ═══════════════════════════════════════════════════════════════════════
// AI STUDIO COPILOT (Prompt 36)
// ═══════════════════════════════════════════════════════════════════════

/// One chat thread between a studio user and the copilot. Scoped to
/// both `studioId` and the `StudioUser` who owns it — "Never allow
/// cross-tenant AI context" starts here: every tool call made within
/// a conversation is executed with *this* conversation's own
/// `studioId`, injected by `apps/api`'s orchestration loop, never a
/// value the model itself could supply or influence.
model CopilotConversation {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  title String?

  createdAt     DateTime @default(now()) @map("created_at")
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  studio   Studio          @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user     StudioUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CopilotMessage[]
  actions  CopilotAction[]

  @@index([studioId])
  @@index([userId])
  @@map("copilot_conversations")
}

enum CopilotMessageRole {
  user
  assistant
}

/// One turn in a conversation. `sourceReferences` is "Source
/// references" — an array of `{ type, id }` pointers to the actual
/// records (events, invoices, clients) a read-only answer was drawn
/// from, so a studio user can verify an answer rather than trust it
/// blindly; populated whenever a read tool backed the response, left
/// empty for pure conversation. `toolCalls` is a snapshot of what the
/// model actually invoked to produce this message, kept for the same
/// reason `ContractVersion` keeps every past version — an inspectable
/// record of how an answer was reached, not just the answer itself.
model CopilotMessage {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid

  role    CopilotMessageRole
  content String

  toolCalls        Json? @map("tool_calls")
  sourceReferences  Json? @map("source_references") // [{ type: "Event", id: "..." }, ...]

  createdAt DateTime @default(now()) @map("created_at")

  conversation CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actions      CopilotAction[]

  @@index([conversationId])
  @@map("copilot_messages")
}

enum CopilotActionStatus {
  draft
  confirmed
  executed
  rejected
  reversed
}

/// Build phases 2–3 ("Draft actions", "Confirmed actions") live here.
/// A copilot-proposed write is *never* executed directly from a tool
/// call — it's persisted as a `draft` first, a human explicitly
/// confirms it (`confirmed` → `executed`), and only actions the
/// studio user themselves approved ever touch real data.
/// `isReversible`/`reversalData` are "Reversible actions": for action
/// types this codebase can genuinely undo (voiding a quotation it
/// drafted, deleting a shot list it created), the information needed
/// to reverse the effect is captured at execution time, not
/// reconstructed later from guesswork.
model CopilotAction {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  messageId      String? @map("message_id") @db.Uuid

  actionType String              @map("action_type") // e.g. "create_quotation", "draft_payment_reminder", "create_shot_list"
  status     CopilotActionStatus @default(draft)

  payload    Json // the proposed action's own parameters, exactly as the model proposed them
  resultData Json? @map("result_data") // what was actually created/changed once executed, e.g. { quotationId: "..." }

  isReversible Boolean   @default(false) @map("is_reversible")
  reversalData Json?     @map("reversal_data") // whatever's needed to undo this specific action — captured at execution time
  reversedAt   DateTime? @map("reversed_at")

  confirmedBy String?   @map("confirmed_by") @db.Uuid
  confirmedAt DateTime? @map("confirmed_at")
  executedAt  DateTime? @map("executed_at")

  createdAt DateTime @default(now()) @map("created_at")

  conversation CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      CopilotMessage?     @relation(fields: [messageId], references: [id])

  @@index([conversationId])
  @@index([conversationId, status])
  @@map("copilot_actions")
}

enum CopilotAuditAction {
  query_received
  tool_called
  action_proposed
  action_confirmed
  action_rejected
  action_executed
  action_reversed
  permission_denied
}

/// "Audit log" — a complete, append-only record of everything the
/// copilot did on a studio user's behalf, independent of the
/// conversation transcript itself (which a user could in principle
/// delete). `toolName`/`metadata` capture enough to reconstruct what
/// happened without replaying the model — this is the record a studio
/// owner reviews if they want to know exactly what the AI touched and
/// when.
model CopilotAuditLogEntry {
  id             String @id @default(uuid()) @db.Uuid
  studioId       String @map("studio_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid

  action   CopilotAuditAction
  toolName String?            @map("tool_name")
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user   StudioUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([conversationId])
  @@index([studioId, createdAt])
  @@map("copilot_audit_log_entries")
}

// ═══════════════════════════════════════════════════════════════════════
// AI MARKETING STUDIO (Prompt 37)
// ═══════════════════════════════════════════════════════════════════════

enum MarketingContentType {
  instagram_caption
  reel_script
  hashtags
  facebook_post
  google_business_post
  email_campaign
  whatsapp_campaign
  festival_greeting
  review_request
  referral_campaign
  package_description
  seo_title
  blog_outline
}

enum MarketingLanguage {
  english
  tamil
  kannada
  telugu
  hindi
}

/// A studio's own captured brand voice — "Studio brand voice" as an
/// input the brief names, distinct from `StudioBrand` (Prompt 9's
/// visual branding: logo, colors) since tone of voice and visual
/// identity are independent things a studio configures separately.
/// One row per studio (a genuine per-tenant singleton, the same
/// convention `PlatformCommerceSettings` uses at the platform level).
model MarketingBrandVoiceSettings {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @unique @map("studio_id") @db.Uuid

  toneDescription String? @map("tone_description") // free text: "warm, a little playful, never salesy"
  keyPhrases      String[] @default([]) @map("key_phrases") // phrases the studio likes to reuse
  avoidPhrases    String[] @default([]) @map("avoid_phrases") // phrases/words the studio wants generated content to avoid

  updatedAt DateTime @updatedAt @map("updated_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@map("marketing_brand_voice_settings")
}

/// One generated piece of content and the inputs that produced it —
/// a full history, not just the latest result, so a studio can revisit
/// what worked. `generatedContent` is the actual text Claude returned;
/// `inputs` snapshots every structured input (service, city, target
/// audience, tone, offer, platform) exactly as given, independent of
/// whatever `MarketingBrandVoiceSettings` says today — a later brand
/// voice change never retroactively reinterprets what an old request
/// actually produced.
model MarketingContentRequest {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  contentType MarketingContentType
  language    MarketingLanguage    @default(english)

  inputs Json // { service, city, targetAudience, tone, offer, platform }
  generatedContent String @map("generated_content")

  isApproved         Boolean @default(false) @map("is_approved")
  savedAsBrandExample Boolean @default(false) @map("saved_as_brand_example")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio        Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  brandExample  BrandVoiceExample?

  @@index([studioId])
  @@index([studioId, contentType])
  @@map("marketing_content_requests")
}

/// "Allow users to save approved brand examples" — a studio marking a
/// generated (or hand-written) piece as a genuine example of their
/// voice. These are fed back into future generation prompts as
/// few-shot examples (`apps/api`'s `marketing-content.service.ts`),
/// which is what actually makes "studio brand voice" calibrate over
/// time rather than staying a static tone description forever.
model BrandVoiceExample {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  contentType MarketingContentType
  language    MarketingLanguage    @default(english)
  content     String

  sourceRequestId String? @unique @map("source_request_id") @db.Uuid // set when saved directly from a generation result; null when a studio pasted in their own hand-written example

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio        Studio                   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  sourceRequest MarketingContentRequest? @relation(fields: [sourceRequestId], references: [id], onDelete: SetNull)

  @@index([studioId])
  @@index([studioId, contentType])
  @@map("brand_voice_examples")
}

// ═══════════════════════════════════════════════════════════════════════
// AUTOMATION BUILDER (Prompt 38)
// ═══════════════════════════════════════════════════════════════════════

enum AutomationTriggerType {
  lead_created
  lead_inactive
  follow_up_due
  quotation_sent
  quotation_viewed
  quotation_accepted
  booking_confirmed
  payment_due
  payment_overdue
  event_upcoming
  gallery_published
  selection_pending
  album_approved
  delivery_completed
  birthday
  anniversary
}

enum AutomationActionType {
  send_whatsapp
  send_email
  create_task
  assign_user
  update_status
  add_tag
  generate_invoice
  send_notification
  call_webhook
  wait
  condition_branch
}

/// One automation — a trigger plus the graph of steps it runs.
/// `maxExecutionsPerHour` is "Rate limiting" scoped per-rule (not
/// studio-wide), since a runaway rule (e.g. one that fires on
/// `lead_created` and itself creates a lead) is a per-rule hazard, not
/// a studio-wide one — `apps/api`'s execution service checks recent
/// `AutomationExecution` count against this before starting a new run
/// and marks the run `rate_limited` rather than silently dropping it.
/// "Usage enforcement" is separate and platform-wide — reuses the
/// already-existing `maxAutomationRunsPerMonth` plan-limit dimension
/// from `@bcp/billing`, the same `assertWithinPlanLimit()`/
/// `recordUsage()` pair every other metered AI/automation feature in
/// this codebase already uses.
model AutomationRule {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  name        String
  description String?
  triggerType   AutomationTriggerType @map("trigger_type")
  triggerConfig Json?                 @map("trigger_config") // trigger-specific filters, e.g. { daysOverdue: 3 } for payment_overdue

  isActive             Boolean @default(false) @map("is_active") // "Enable and disable" — a rule is inert until explicitly turned on
  maxExecutionsPerHour Int     @default(100) @map("max_executions_per_hour")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio     Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  steps      AutomationStep[]
  executions AutomationExecution[]

  @@index([studioId])
  @@index([studioId, triggerType])
  @@index([studioId, isActive])
  @@map("automation_rules")
}

/// One node in the automation's step graph — "Visual workflow editor"
/// persists as this graph, `positionX`/`positionY` recording where a
/// studio placed the node on the canvas (purely presentational, never
/// read by the execution engine, which only ever follows
/// `nextStepId`/the branch pointers). A `condition_branch` step is the
/// one type with two possible next steps instead of one; every other
/// action type has at most one `nextStepId`, making the graph a tree
/// with exactly one branching node type — deliberately simple rather
/// than a fully general DAG a visual editor would be much harder to
/// keep comprehensible for a studio owner, not a developer, to build.
model AutomationStep {
  id      String @id @default(uuid()) @db.Uuid
  ruleId  String @map("rule_id") @db.Uuid

  actionType   AutomationActionType @map("action_type")
  actionConfig Json?                @map("action_config") // e.g. { templateId, to } for send_whatsapp; { conditionField, operator, value } for condition_branch; { minutes } for wait

  positionX Int @default(0) @map("position_x")
  positionY Int @default(0) @map("position_y")

  nextStepId          String? @map("next_step_id") @db.Uuid // every non-branch action's single successor
  conditionTrueStepId  String? @map("condition_true_step_id") @db.Uuid // condition_branch only
  conditionFalseStepId String? @map("condition_false_step_id") @db.Uuid // condition_branch only

  isEntryPoint Boolean @default(false) @map("is_entry_point") // the one step the rule starts executing from

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("automation_steps")
}

enum AutomationExecutionStatus {
  pending
  running
  completed
  failed
  retrying
  rate_limited
}

/// One real (or test-mode) run of a rule, triggered by one real event
/// in the studio's own data. `isTestRun` is "Test mode" — a test run
/// executes the exact same step graph but every action implementation
/// checks this flag and simulates its effect (logging what it *would*
/// have sent/created) instead of actually sending a WhatsApp message,
/// creating a task, or calling a webhook — so a studio can safely
/// verify a new automation before enabling it for real.
/// `triggerContext` snapshots which entity triggered this run (e.g.
/// `{ leadId: "..." }`), independent of that entity's own later
/// changes.
model AutomationExecution {
  id     String @id @default(uuid()) @db.Uuid
  ruleId String @map("rule_id") @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  status        AutomationExecutionStatus @default(pending)
  isTestRun     Boolean                   @default(false) @map("is_test_run")
  triggerContext Json                     @map("trigger_context")

  errorMessage String? @map("error_message")

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  rule          AutomationRule          @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  studio        Studio                  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  stepExecutions AutomationStepExecution[]

  @@index([ruleId])
  @@index([studioId])
  @@index([ruleId, startedAt])
  @@map("automation_executions")
}

enum AutomationStepExecutionStatus {
  pending
  running
  succeeded
  failed
  skipped
  retrying
}

/// "Retry" and "Failure handling" both live here — `attemptCount`
/// tracks how many times this specific step has been tried,
/// `errorMessage` records the most recent failure, and a `failed` step
/// (after retries are exhausted — `@bcp/automation`'s
/// `hasRetriesRemaining()`) stops that execution's graph traversal
/// rather than silently skipping ahead, so a studio always sees
/// exactly where an automation actually broke.
model AutomationStepExecution {
  id          String @id @default(uuid()) @db.Uuid
  executionId String @map("execution_id") @db.Uuid
  stepId      String @map("step_id") @db.Uuid

  status       AutomationStepExecutionStatus @default(pending)
  attemptCount Int                           @default(0) @map("attempt_count")
  resultData   Json?                         @map("result_data")
  errorMessage String?                       @map("error_message")

  executedAt DateTime @default(now()) @map("executed_at")

  execution AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("automation_step_executions")
}

// ═══════════════════════════════════════════════════════════════════════
// REPORTS & ANALYTICS (Prompt 39)
// ═══════════════════════════════════════════════════════════════════════

enum ReportType {
  leads
  sources
  conversion
  quotations
  bookings
  revenue
  payments
  outstanding_amounts
  expenses
  profit
  packages
  event_types
  branches
  team_performance
  freelancer_cost
  album_production
  gallery_activity
  client_satisfaction
  referrals
  storage
  ai_usage
  whatsapp_usage
}

enum ScheduledReportFrequency {
  daily
  weekly
  monthly
}

/// A studio's own saved report configuration — "Saved reports" as a
/// genuine reusable filter set (date range, branch, user), not just a
/// bookmark of a URL. `filters` snapshots exactly what was chosen so
/// re-opening a saved report reproduces the same query every time,
/// independent of whatever the report-builder UI's own defaults are
/// by the time anyone reopens it.
model SavedReport {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  reportType ReportType
  name       String
  filters    Json? // { fromDate, toDate, branchId, userId, ... }

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio           Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  scheduledReports ScheduledReport[]

  @@index([studioId])
  @@index([studioId, reportType])
  @@map("saved_reports")
}

/// "Scheduled reports" — a `SavedReport` a studio wants generated and
/// emailed on a recurring cadence, entirely independent of anyone
/// opening the report UI. `nextSendAt` is computed and stored (not
/// derived on the fly) so a scheduler job can cheaply query "what's
/// due right now" with a single indexed comparison.
model ScheduledReport {
  id            String @id @default(uuid()) @db.Uuid
  studioId      String @map("studio_id") @db.Uuid
  savedReportId String @map("saved_report_id") @db.Uuid

  frequency        ScheduledReportFrequency
  recipientEmails  String[]                 @default([]) @map("recipient_emails")
  isActive         Boolean                  @default(true) @map("is_active")

  lastSentAt DateTime? @map("last_sent_at")
  nextSendAt DateTime  @map("next_send_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio      Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  savedReport SavedReport @relation(fields: [savedReportId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([isActive, nextSendAt])
  @@map("scheduled_reports")
}

// ═══════════════════════════════════════════════════════════════════════
// GLOBAL SEARCH & COMMAND MENU (Prompt 40)
// ═══════════════════════════════════════════════════════════════════════

/// "Recent searches" — an append-only-per-user log, pruned to the most
/// recent N by `apps/api` (never a hard DB constraint), scoped to both
/// the studio *and* the individual `StudioUser` — one person's search
/// history is never shown to a colleague, even within the same studio.
model RecentSearch {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  query String

  createdAt DateTime @default(now()) @map("created_at")

  studio Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user   StudioUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([userId, createdAt])
  @@map("recent_searches")
}

/// "Saved searches" — a genuine reusable query a user names and
/// revisits, distinct from `RecentSearch`'s passive history.
/// `entityTypes` snapshots which of the 13 searchable entities the
/// search was scoped to, so reopening a saved search reproduces
/// exactly the same scope even if a user's own default filters change
/// later.
model SavedSearch {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  name        String
  query       String
  entityTypes String[] @default([]) @map("entity_types")

  createdAt DateTime @default(now()) @map("created_at")

  studio Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user   StudioUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([userId])
  @@map("saved_searches")
}

// ═══════════════════════════════════════════════════════════════════════
// IMPORT, EXPORT & BACKUP (Prompt 41)
// ═══════════════════════════════════════════════════════════════════════

enum ImportEntityType {
  leads
  clients
  packages
  services
  payments
  vendors
  equipment
  gallery_metadata
}

enum ImportJobStatus {
  uploaded
  mapping
  previewing
  processing
  completed
  failed
  partially_completed
}

enum DuplicateHandling {
  skip
  overwrite
  create_new
}

/// One CSV import — the full pipeline from upload through completion.
/// `columnMapping` is "Column mapping" (`{ csvColumnHeader:
/// entityFieldName }`), captured explicitly rather than assuming a
/// fixed header order, since a studio's own export from another tool
/// rarely matches this platform's field names exactly. "Background
/// processing" in this environment means the same synchronous-
/// execution-with-persisted-status pattern used throughout this
/// codebase (e.g. Automation Builder's `wait` steps) rather than a
/// real job queue this sandbox has no infrastructure for — status
/// still moves through real states (`uploaded` → `mapping` →
/// `previewing` → `processing` → `completed`/`failed`), it just
/// advances within one request/response cycle instead of a
/// backgrounded worker picking it up later.
model ImportJob {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  entityType ImportEntityType @map("entity_type")
  status     ImportJobStatus  @default(uploaded)

  fileKey       String  @map("file_key")
  columnMapping Json?   @map("column_mapping")
  duplicateHandling DuplicateHandling @default(skip) @map("duplicate_handling")

  totalRows     Int @default(0) @map("total_rows")
  processedRows Int @default(0) @map("processed_rows")
  successCount  Int @default(0) @map("success_count")
  errorCount    Int @default(0) @map("error_count")
  duplicateCount Int @default(0) @map("duplicate_count")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  createdBy   String?   @map("created_by") @db.Uuid

  studio Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  errors ImportJobError[]

  @@index([studioId])
  @@index([studioId, status])
  @@map("import_jobs")
}

/// "Error report" — one row per failed record, kept independent of
/// the job's own summary counts so a studio can see (and, per "Retry",
/// re-attempt) exactly which rows failed and why, not just how many.
model ImportJobError {
  id          String @id @default(uuid()) @db.Uuid
  importJobId String @map("import_job_id") @db.Uuid

  rowNumber    Int
  rawData      Json    @map("raw_data")
  errorMessage String  @map("error_message")
  retried      Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@map("import_job_errors")
}

enum ExportEntityType {
  leads
  clients
  bookings
  events
  payments
  expenses
  galleries
  albums
  audit_logs
  complete_studio_data
}

enum ExportJobStatus {
  pending
  processing
  completed
  failed
}

/// One export request — "Complete studio data" is the same pipeline as
/// every other export type, just covering every entity at once rather
/// than one. `expiresAt` bounds how long the generated file's download
/// link stays valid, the same "don't leave a data export sitting
/// around forever" instinct as signed URLs elsewhere in this codebase.
model ExportJob {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  exportType ExportEntityType @map("export_type")
  status     ExportJobStatus  @default(pending)

  filters Json?
  fileKey String? @map("file_key")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  expiresAt   DateTime? @map("expires_at")
  createdBy   String?   @map("created_by") @db.Uuid

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("export_jobs")
}

enum BackupStatus {
  requested
  pending_approval
  approved
  rejected
  processing
  completed
  failed
}

/// "Encrypted full-studio backup ... with Platform Admin approval" —
/// a studio can only *request* a backup; it never runs until a
/// `PlatformUser` explicitly approves it (`approvedBy`/`approvedAt`),
/// the same "propose, then a human with real authority confirms"
/// shape the AI Studio Copilot's draft-action workflow already
/// established for a different kind of sensitive action.
/// `encryptionKeyId` references the key used to encrypt the backup
/// file at rest — never the key material itself, which this schema
/// never stores.
model StudioBackup {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  status BackupStatus @default(requested)

  fileKey         String? @map("file_key")
  sizeBytes       Int?    @map("size_bytes")
  encryptionKeyId String? @map("encryption_key_id")

  requestedBy    String?   @map("requested_by") @db.Uuid
  requestedAt    DateTime  @default(now()) @map("requested_at")
  approvedBy     String?   @map("approved_by") @db.Uuid // PlatformUser — never a StudioUser; a studio cannot approve its own backup
  approvedAt     DateTime? @map("approved_at")
  rejectedReason String?   @map("rejected_reason")

  completedAt DateTime? @map("completed_at")

  studio       Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  restoreJobs  StudioRestoreJob[]

  @@index([studioId])
  @@index([status])
  @@map("studio_backups")
}

enum RestoreJobStatus {
  requested
  pending_approval
  approved
  rejected
  processing
  completed
  failed
}

/// Restoring is at least as sensitive as backing up (it overwrites
/// live data), so it carries the exact same Platform Admin approval
/// gate as `StudioBackup` — a studio requests, a platform admin
/// approves, and only then does anything actually run.
model StudioRestoreJob {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid
  backupId String @map("backup_id") @db.Uuid

  status RestoreJobStatus @default(requested)

  requestedBy String?   @map("requested_by") @db.Uuid
  requestedAt DateTime  @default(now()) @map("requested_at")
  approvedBy  String?   @map("approved_by") @db.Uuid
  approvedAt  DateTime? @map("approved_at")
  rejectedReason String? @map("rejected_reason")

  completedAt  DateTime? @map("completed_at")
  errorMessage String?   @map("error_message")

  studio Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  backup StudioBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([backupId])
  @@map("studio_restore_jobs")
}

// ═══════════════════════════════════════════════════════════════════════
// NOTES (Prompt 42 — PWA offline-queueable "Add notes")
// ═══════════════════════════════════════════════════════════════════════

/// A generic, polymorphic note attachable to any entity — built for
/// the PWA's offline note-queueing ("Add notes" is one of the brief's
/// offline-supported operations), but usable anywhere a quick,
/// timestamped, freeform note is useful. Deliberately append-only:
/// each note is its own row, so replaying a queued offline note twice
/// (a real risk with any offline queue, since the client can't always
/// tell whether an earlier sync attempt actually landed) just creates
/// a harmless duplicate row rather than corrupting or overwriting
/// anything — the same "safe to retry" property every other
/// offline-queueable action in this app was chosen for.
model Note {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  entityType String @map("entity_type") // e.g. "Event", "Lead", "Client" — whatever the note is attached to
  entityId   String @map("entity_id") @db.Uuid

  content String

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([entityType, entityId])
  @@map("notes")
}

// ═══════════════════════════════════════════════════════════════════════
// ACCOUNT & STUDIO DELETION (Prompt 43 — Security Hardening)
// ═══════════════════════════════════════════════════════════════════════

enum StudioDeletionStatus {
  requested
  pending_approval
  approved
  rejected
  processing
  completed
  failed
}

/// "Studio deletion" — deliberately carries the exact same Platform
/// Admin approval gate as `StudioBackup`/`StudioRestoreJob` (Prompt
/// 41): a studio owner can request their own studio's permanent
/// deletion, but only a `PlatformUser` can approve it, and
/// `approvedBy` is never a `StudioUser` ID. This is the single most
/// destructive action in the entire platform, so it gets the same
/// two-step human-in-the-loop discipline as encrypted backup/restore,
/// not a lighter one.
model StudioDeletionRequest {
  id       String @id @default(uuid()) @db.Uuid
  studioId String @map("studio_id") @db.Uuid

  status StudioDeletionStatus @default(requested)
  reason String?

  requestedBy    String?   @map("requested_by") @db.Uuid
  requestedAt    DateTime  @default(now()) @map("requested_at")
  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at")
  rejectedReason String?   @map("rejected_reason")

  completedAt DateTime? @map("completed_at")

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("studio_deletion_requests")
}

// ═══════════════════════════════════════════════════════════════════════
// MONITORING & OBSERVABILITY (Prompt 46)
// ═══════════════════════════════════════════════════════════════════════

enum MonitoredService {
  api
  database
  redis
  storage
  ai_provider
  whatsapp
  payment_provider
  queue
}

enum ServiceHealthStatus {
  healthy
  degraded
  unhealthy
}

/// One point-in-time health check for one service — the raw material
/// every other observability feature reads from: "Platform health
/// dashboard" shows the latest row per service, "Service uptime
/// tracking" computes a percentage from the history, and "Alert
/// rules" evaluate their own condition against recent rows rather
/// than a single live check (so a single transient blip doesn't fire
/// an alert on its own — see `@bcp/observability`'s
/// `evaluateAlertCondition()`). Kept as an append-only log, not a
/// single upserted row per service, specifically so uptime and
/// incident correlation have real history to work from.
model ServiceHealthCheck {
  id      String              @id @default(uuid()) @db.Uuid
  service MonitoredService
  status  ServiceHealthStatus

  latencyMs    Int?    @map("latency_ms")
  errorMessage String? @map("error_message")

  checkedAt DateTime @default(now()) @map("checked_at")

  @@index([service, checkedAt])
  @@map("service_health_checks")
}

/// "Alert rules" — a platform admin's own configured thresholds for
/// when a service's degraded health should actually page someone,
/// rather than a hardcoded rule buried in application code. Evaluated
/// against recent `ServiceHealthCheck` rows for the named service;
/// `consecutiveFailuresRequired` is what keeps a single transient
/// health-check blip from firing an alert — the same "don't alert on
/// noise" instinct behind requiring a job to exhaust its retries
/// before dead-lettering (Prompt 44).
model AlertRule {
  id   String @id @default(uuid()) @db.Uuid
  name String

  service                     MonitoredService
  triggerStatus               ServiceHealthStatus @map("trigger_status") // fires when the service reaches (or worsens past) this status
  consecutiveFailuresRequired Int                 @default(2) @map("consecutive_failures_required")

  isActive Boolean @default(true) @map("is_active")

  notifyEmails String[] @default([]) @map("notify_emails")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  triggeredAlerts TriggeredAlert[]

  @@map("alert_rules")
}

/// One firing of an `AlertRule` — kept distinct from the rule itself
/// so a rule's own firing history is inspectable, and so the same
/// rule doesn't fire a second alert every single health-check cycle
/// while the underlying problem is still ongoing (`resolvedAt` null
/// means still active; a rule already actively firing is not
/// re-triggered until it resolves and recurs).
model TriggeredAlert {
  id          String @id @default(uuid()) @db.Uuid
  alertRuleId String @map("alert_rule_id") @db.Uuid

  triggeredAt DateTime  @default(now()) @map("triggered_at")
  resolvedAt  DateTime? @map("resolved_at")

  alertRule AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)

  @@index([alertRuleId])
  @@index([alertRuleId, resolvedAt])
  @@map("triggered_alerts")
}

enum IncidentSeverity {
  sev1
  sev2
  sev3
}

enum IncidentStatus {
  investigating
  identified
  monitoring
  resolved
}

/// "Incident history" — the record a public status page's incident
/// timeline is built from, and also this platform's own internal
/// record for whoever's on the other end of an alert (see
/// docs/incident-response-guide.md, Prompt 43). `affectedServices`
/// is deliberately a plain string array of `MonitoredService` keys
/// rather than a join table — an incident's own service list is
/// small and fixed once posted, not something queried independently
/// of the incident itself.
model Incident {
  id    String @id @default(uuid()) @db.Uuid
  title String

  severity IncidentSeverity
  status   IncidentStatus   @default(investigating)

  affectedServices String[] @default([]) @map("affected_services")

  startedAt  DateTime  @default(now()) @map("started_at")
  resolvedAt DateTime? @map("resolved_at")

  createdBy String? @map("created_by") @db.Uuid

  updates IncidentUpdate[]

  @@index([status])
  @@index([startedAt])
  @@map("incidents")
}

/// A timestamped post within an incident's own timeline — the
/// standard status-page convention ("Investigating," "Identified,"
/// "Monitoring," "Resolved," each with its own note), kept as its own
/// append-only log rather than overwriting the incident's own
/// description each time, so the full history of what was known and
/// when stays intact.
model IncidentUpdate {
  id         String @id @default(uuid()) @db.Uuid
  incidentId String @map("incident_id") @db.Uuid

  status  IncidentStatus
  message String

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_updates")
}
