// ═══════════════════════════════════════════════════════════════════════
// PLATFORM — BCP Studio OS staff & platform-level RBAC
// (No studioId anywhere in this section — this is not tenant data.)
// ═══════════════════════════════════════════════════════════════════════

/// A human at BCP Studio OS (the company) who can sign in to platform-admin.
/// Distinct from StudioUser — a platform employee does not automatically
/// have access to any studio's data; that would require a separate,
/// explicitly-audited StudioUser membership (see docs/tenant-isolation.md).
model PlatformUser {
  id           String              @id @default(uuid()) @db.Uuid
  email        String              @unique
  passwordHash String?             @map("password_hash")
  name         String
  avatarUrl    String?             @map("avatar_url")
  status       PlatformUserStatus  @default(invited)
  lastLoginAt  DateTime?           @map("last_login_at")

  emailVerifiedAt    DateTime? @map("email_verified_at")
  googleSubject      String?   @unique @map("google_subject")

  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?   @map("two_factor_secret") // encrypted at rest by the app layer, never plaintext
  twoFactorEnabledAt  DateTime? @map("two_factor_enabled_at")

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  roles PlatformUserRole[]

  @@index([status])
  @@index([deletedAt])
  @@map("platform_users")
}

/// Catalog of permission keys the platform-admin app understands, e.g.
/// "studio:suspend", "license:issue". Seeded by the app, not tenant data.
/// See docs/database-conventions.md § "Roles & permissions" for why this
/// is a flat catalog rather than a normalized Role↔Permission join table.
model PlatformPermission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  label       String
  description String?
  category    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("platform_permissions")
}

/// A role at the platform level. `permissions` is an array of
/// PlatformPermission.key values — custom roles are supported by simply
/// inserting a new row with `isSystem = false` and any permission subset.
model PlatformRole {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  permissions String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  userRoles PlatformUserRole[]

  @@map("platform_roles")
}

/// Join table: which platform roles a platform user holds. A user can hold
/// more than one role (e.g. "billing_admin" + "support").
model PlatformUserRole {
  id             String   @id @default(uuid()) @db.Uuid
  platformUserId String   @map("platform_user_id") @db.Uuid
  platformRoleId String   @map("platform_role_id") @db.Uuid
  assignedAt     DateTime @default(now()) @map("assigned_at")
  assignedBy     String?  @map("assigned_by") @db.Uuid

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  platformRole PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)

  @@unique([platformUserId, platformRoleId])
  @@index([platformRoleId])
  @@map("platform_user_roles")
}

