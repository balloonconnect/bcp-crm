// ─────────────────────────────────────────────────────────────────────────
// BCP Studio OS — Platform & Multi-Tenant Data Model
//
// This schema models two identity/authorization planes that never share a
// table:
//   • PLATFORM  — BCP Studio OS's own staff (support, licensing, ops) who
//                 operate platform-admin. Nothing here is tenant data.
//   • STUDIO    — a tenant ("Studio") and everything scoped to it: its
//                 users, branches, custom roles, subscription, licenses,
//                 and activity.
//
// See docs/tenant-isolation.md for how isolation is enforced in code, and
// docs/database-conventions.md for the naming/typing rules this file
// follows (UUIDs, snake_case columns, soft delete, audit columns, etc).
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

