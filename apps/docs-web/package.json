{
  "name": "@bcp/docs-web",
  "version": "0.1.0",
  "private": true,
  "description": "Product and API documentation site",
  "scripts": {
    "dev": "next dev --port 3005",
    "build": "next build",
    "start": "next start --port 3005",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@bcp/ui": "workspace:*",
    "@bcp/types": "workspace:*",
    "@bcp/validation": "workspace:*",
    "@bcp/config": "workspace:*",
    "@bcp/branding": "workspace:*",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "next": "^14.2.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint-config-next": "^14.2.13",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1",
    "jsdom": "^25.0.1",
    "@testing-library/react": "^16.0.1"
  }
