NODE_ENV=development
APP_URL=http://localhost:3000

# Lead capture (contact form, demo requests) — sent via the shared @bcp/email
# client, defaults match the local Mailpit dev setup in docker-compose.yml.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="BCP Studio OS <hello@bcpstudio.app>"
LEADS_NOTIFICATION_EMAIL=sales@bcpstudio.app

# Analytics — no provider is wired by default; set this to enable loading
# one behind the cookie-consent gate (see components/layout/cookie-consent.tsx).
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_SITE_URL=https://bcpstudio.app

# Where the actual product lives — Register links here to start the
# studio onboarding wizard (see apps/studio-web's /onboarding).
NEXT_PUBLIC_APP_URL=http://localhost:3002
