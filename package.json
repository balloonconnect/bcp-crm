{
  "name": "bcp-studio-os",
  "version": "0.1.0",
  "private": true,
  "description": "BCP Studio OS — white-label photography SaaS platform (Turborepo monorepo)",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\" --cache",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "storybook": "pnpm --filter @bcp/ui storybook",
    "build-storybook": "turbo run build-storybook --filter=@bcp/ui",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @bcp/database generate",
    "db:migrate": "pnpm --filter @bcp/database migrate",
    "db:studio": "pnpm --filter @bcp/database studio",
    "test:e2e": "pnpm --filter @bcp/e2e test:e2e",
    "security:audit": "pnpm audit --audit-level=high",
    "security:secrets-scan": "bash scripts/secrets-scan.sh",
    "prepare": "husky",
    "changeset": "changeset",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "**/*.{ts,tsx,js,jsx,json,md,mdx,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.4.1"
    }
  }
}
